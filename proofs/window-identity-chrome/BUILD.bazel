load("@proof_window_identity//:defs.bzl", "all_crate_deps")
load(
    "@rules_rust//rust:defs.bzl",
    "rust_clippy_test",
    "rust_doc_test",
    "rust_library",
    "rust_test",
)

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel", "Cargo.lock", "Cargo.toml", "README.md"])

rust_library(
    name = "window_identity_chrome",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_name = "window_identity_chrome_proof",
    deps = [
        "@proof_window_identity//:serde",
        "@proof_window_identity//:serde_json",
    ],
)

rust_test(
    name = "unit",
    compile_data = ["Cargo.toml"],
    crate = ":window_identity_chrome",
    deps = all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_clippy_test(
    name = "clippy",
    targets = [":window_identity_chrome"],
    transitive = True,
)

rust_doc_test(
    name = "doc",
    crate = ":window_identity_chrome",
)
