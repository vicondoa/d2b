module(
    name = "d2b",
    version = "3.0.0",
)

bazel_dep(name = "rules_rs", version = "0.0.105")
bazel_dep(name = "llvm", version = "0.8.9")
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")
bazel_dep(name = "aspect_rules_lint", version = "2.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_lib", version = "3.7.1")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "protobuf", version = "34.0.bcr.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

archive_override(
    module_name = "rules_rs",
    integrity = "sha256-KE4xcf3WAoxT+UjzUNtEUDEuYcnk/2VBd3ytms8f5gE=",
    strip_prefix = "rules_rs-0.0.105",
    urls = ["https://github.com/hermeticbuild/rules_rs/releases/download/v0.0.105/rules_rs-v0.0.105.tar.gz"],
)

nix_repo = use_extension(
    "@rules_nixpkgs_core//extensions:repository.bzl",
    "nix_repo",
)
nix_repo.expr(
    name = "nixpkgs",
    expr = """let
  lock = builtins.fromJSON (builtins.readFile ./flake.lock);
  src = lock.nodes.nixpkgs.locked;
in
import (builtins.fetchTarball {
  url = "https://github.com/${src.owner}/${src.repo}/archive/${src.rev}.tar.gz";
  sha256 = src.narHash;
})
""",
    file_deps = ["//:flake.lock"],
)
use_repo(nix_repo, "nixpkgs")

nix_packages = use_extension(
    "@rules_nixpkgs_core//extensions:package.bzl",
    "nix_pkg",
)
nix_packages.attr(
    name = "nix",
    attr = "nix",
    repo = "@nixpkgs",
)
nix_packages.attr(
    name = "nix_unit",
    attr = "nix-unit",
    repo = "@nixpkgs",
)
nix_packages.attr(
    name = "nix_eval_jobs",
    attr = "nix-eval-jobs",
    repo = "@nixpkgs",
)
nix_packages.attr(
    name = "python3",
    attr = "python3",
    repo = "@nixpkgs",
)
use_repo(nix_packages, "nix", "nix_eval_jobs", "nix_unit", "python3")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.97.0",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.annotation(
    build_script_env = {
        "PROTOC": "protoc",
        "PROTOC_INCLUDE": ".",
    },
    crate = "prost-build",
    version = "0.8.0",
)
use_repo(crate, "crates")

proof_crates = use_extension("@rules_rs//rs:extensions.bzl", "crate")
proof_crates.from_cargo(
    name = "proof_chunked",
    cargo_lock = "//proofs/chunked-stdio-conformance:Cargo.lock",
    cargo_toml = "//proofs/chunked-stdio-conformance:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
proof_crates.from_cargo(
    name = "proof_redb",
    cargo_lock = "//proofs/redb-resource-store-spike:Cargo.lock",
    cargo_toml = "//proofs/redb-resource-store-spike:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
proof_crates.from_cargo(
    name = "proof_w0_ch_connect",
    cargo_lock = "//proofs/w0-ch-connect-proof:Cargo.lock",
    cargo_toml = "//proofs/w0-ch-connect-proof:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
proof_crates.from_cargo(
    name = "proof_window_identity",
    cargo_lock = "//proofs/window-identity-chrome:Cargo.lock",
    cargo_toml = "//proofs/window-identity-chrome:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(
    proof_crates,
    "proof_chunked",
    "proof_redb",
    "proof_w0_ch_connect",
    "proof_window_identity",
)
