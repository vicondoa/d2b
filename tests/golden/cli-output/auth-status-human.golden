role: launcher
effective uid: 1000
sockets:
- public: reachable (version 0.4.0-test)
- broker: unreachable
allowed subcommands: audio, auth status, boot, build, console, down, generations, launch, list, op inspect, realm enter, realm inspect, realm list, realm run, restart, rollback, status, switch, test, up, usb
denied subcommands:
- audit: audit requires admin role in `d2b.site.adminUsers`.
