      "description": "The action compares generated outputs with the committed tree."
    },
    {
      "id": "stable-self-hosted-runner",
      "description": "The advisory budget needs a pinned self-hosted runner."
    },
    {
      "id": "fixture-realization",
      "description": "The action materializes fixture artifacts locally before contract tests."
    },
    {
      "id": "host-or-device-required",
