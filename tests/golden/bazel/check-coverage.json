  "localOnlyReasons": [
    {
      "id": "preflight-gate",
      "description": "The action is a bounded local preflight before the aggregate graph."
    },
    {
      "id": "nix-realization",
      "description": "Nix realization remains local until an unprivileged worker proof passes."
    },
    {
      "id": "generated-artifact-drift",
      "description": "The action compares generated outputs with the committed tree."
    },
    {
      "id": "stable-self-hosted-runner",
      "description": "The advisory budget needs a pinned self-hosted runner."
    },
    {
      "id": "fixture-realization",
      "description": "The action materializes fixture artifacts locally before contract tests."
    },
    {
      "id": "host-or-device-required",
      "description": "The successor needs a container, VM, live host, hardware, or host state."
    },
    {
      "id": "provider-evidence-unavailable",
      "description": "Provider execution is not admitted without independent evidence."
    }
