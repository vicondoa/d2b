load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "meta_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
        ],
        allow_empty = True,
    ),
)

sh_test(
    name = "w0_dep_direction",
    srcs = ["w0-dep-direction.sh"],
    data = [
        "//:Cargo.lock",
        "//:Cargo.toml",
        "//:packages/Cargo.guest.lock",
        "//packages/d2b-contracts:Cargo.toml",
    ],
    env_inherit = ["PATH", "ROOT"],
    tags = [
        "local",
        "no-sandbox",
    ],
)

sh_test(
    name = "rust_main_packages_suite_guard",
    srcs = ["rust-main-packages-suite-guard.sh"],
    # This filegroup is the guard's entire view of the tree, so it must
    # contain every packages/*/BUILD.bazel: the guard's question is which
    # packages declare an all-tests aggregate. A BUILD.bazel missing from it
    # is a package the staged tree cannot describe, and the guard then fails
    # intermittently naming a DIFFERENT package each run - the signature of
    # an incomplete tree, not of a membership gap. One was missing
    # (d2b-test-vm-harness); see the note on //:packages_workspace_sources.
    data = [
        "//:packages_workspace_sources",
        "//bazel/checks:BUILD.bazel",
    ],
    # Deliberately no ROOT: the script derives the runfiles root itself under
    # Bazel, and an ambient ROOT would point the guard at a different tree.
    env_inherit = ["PATH"],
    tags = [
        "local",
        "no-sandbox",
    ],
)
