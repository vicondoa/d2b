load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "gate_sources",
    srcs = glob(
        ["*.sh"],
        allow_empty = True,
    ),
)

sh_test(
    name = "performance_budgets",
    srcs = ["performance-budgets.sh"],
    data = [
        "//packages/d2b:d2b",
        "//packages/d2b-broker:d2b_broker",
        "//packages/d2bd:d2bd",
        "//packages/xtask:xtask",
        "//:tests_root_sources",
        "//bazel/checks/rust:source_hygiene_sources",
    ],
    env = {
        "D2B_BROKER_BIN": "$(execpath //packages/d2b-broker:d2b_broker)",
        "D2B_CLI_BIN": "$(execpath //packages/d2b:d2b)",
        "D2B_DAEMON_BIN": "$(execpath //packages/d2bd:d2bd)",
        "D2B_XTASK_BIN": "$(execpath //packages/xtask:xtask)",
    },
    env_inherit = ["PATH", "ROOT"],
    tags = [
        "local",
        "no-sandbox",
    ],
)

sh_test(
    name = "vms_json_parity",
    srcs = ["vms-json-parity.sh"],
    data = [
        "//:flake.lock",
        "//:flake.nix",
        "//:nix_workspace_sources",
        "//:nixos_modules_workspace_sources",
        "//:tests_root_sources",
        "//:tests_workspace_sources",
        "//bazel/checks/rust:source_hygiene_sources",
    ],
    env_inherit = ["PATH", "ROOT"],
    tags = [
        "local",
        "no-sandbox",
    ],
)
