#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
PROFILE=""
SCRATCH_ROOT="${D2B_BAZEL_CHECK_SCRATCH:-$ROOT/.scratch/bazel-check}"
SCRATCH="$SCRATCH_ROOT/run-${BASHPID}-${RANDOM}"
TARGETS=()
REDACTION_FAILURE_STATUS=75
CONFIGURATION_FAILURE_STATUS=76

xtask() {
  [ -n "${D2B_XTASK_BIN:-}" ] && [ -x "${D2B_XTASK_BIN}" ] || {
    echo "bazel-check: D2B_XTASK_BIN must name the declared //packages/xtask:xtask artifact" >&2
    return 70
  }
  D2B_REPO_ROOT="$ROOT" "$D2B_XTASK_BIN" "$@"
}

redact_file() {
  local path="$1"
  [ -f "$path" ] || return 0
  xtask bazel-evidence redact-log --input "$path" --output "$path" >/dev/null
}

warning_line_status() {
  local path="$1"
  [ -f "$path" ] || return 2
  local status=0
  grep -q '^warning:' "$path" || status=$?
  case "$status" in
    0|1) return "$status" ;;
    *) return 2 ;;
  esac
}

emit_captured_metadata() {
  local path="$1"
  local label="$2"
  if [ -f "$path" ]; then
    printf 'bazel-check: %s retained but suppressed (%s)\n' "$label" "$path" >&2
  else
    printf '%s\n' "bazel-check: ${label} is missing (${path})" >&2
  fi
}

emit_captured_output() {
  local path="$1"
  local label="$2"
  if [ -s "$path" ]; then
    printf '%s\n' "----- ${label} (${path}) -----" >&2
    cat "$path" >&2
    printf '%s\n' "----- end ${label} -----" >&2
  else
    printf '%s\n' "bazel-check: ${label} is empty or missing (${path})" >&2
  fi
}

credential_file() {
  printf '%s\n' "${D2B_BUILDBUDDY_CREDENTIAL_FILE:-${HOME:-}/.config/d2b/buildbuddy-api-key}"
}

BUILD_BUDDY_METADATA_FLAGS=()

git_checkout() {
  local git_bin
  git_bin="$(command -v git)" || return 127
  env -i PATH="$PATH" LC_ALL=C "$git_bin" -C "$ROOT" "$@"
}

git_checkout_snapshot() {
  local branch_head="" commit_sha="" complete=0 record
  while IFS= read -r -d '' record; do
    case "$record" in
      "# branch.head "*) branch_head="${record#\# branch.head }" ;;
      "# branch.oid "*) commit_sha="${record#\# branch.oid }" ;;
      "# d2b.snapshot complete") complete=1 ;;
    esac
  done < <(
    git_checkout status --porcelain=v2 --branch --untracked-files=no -z 2>/dev/null &&
      printf '# d2b.snapshot complete\0'
  )
  [ "$complete" -eq 1 ] && [ -n "$branch_head" ] && [ -n "$commit_sha" ] || return 1
  printf '%s\t%s\n' "$branch_head" "$commit_sha"
}

buildbuddy_metadata() {
  BUILD_BUDDY_METADATA_FLAGS=()
  local checkout_root remote_url commit_sha branch_name snapshot
  local observed_branch_head observed_commit_sha

  if ! checkout_root="$(git_checkout rev-parse --show-toplevel 2>/dev/null)" ||
    [ "$checkout_root" != "$ROOT" ]; then
    echo "bazel-check: BuildBuddy metadata unavailable: Git checkout is unavailable or does not match the tested repository; omitting repository metadata" >&2
    return 0
  fi

  if ! remote_url="$(git_checkout config --local --get remote.origin.url 2>/dev/null)"; then
    echo "bazel-check: BuildBuddy metadata unavailable: Git origin is unavailable; omitting repository metadata" >&2
    return 0
  fi
  case "$remote_url" in
    https://github.com/vicondoa/d2b|https://github.com/vicondoa/d2b.git|\
    git@github.com:vicondoa/d2b|git@github.com:vicondoa/d2b.git|\
    ssh://git@github.com/vicondoa/d2b|ssh://git@github.com/vicondoa/d2b.git)
      ;;
    *)
      echo "bazel-check: BuildBuddy metadata unavailable: Git origin is not the canonical d2b repository; omitting repository metadata" >&2
      return 0
      ;;
  esac

  if ! snapshot="$(git_checkout_snapshot)"; then
    echo "bazel-check: BuildBuddy metadata unavailable: tested commit is unavailable; omitting repository metadata" >&2
    return 0
  fi
  IFS=$'\t' read -r branch_name commit_sha <<<"$snapshot"
  if [ "$branch_name" = "(detached)" ]; then
    echo "bazel-check: BuildBuddy metadata unavailable: checkout is at a detached HEAD; omitting repository metadata" >&2
    return 0
  fi
  if ! git_checkout check-ref-format --branch "$branch_name" >/dev/null 2>&1; then
    echo "bazel-check: BuildBuddy metadata unavailable: branch name is not approved; omitting repository metadata" >&2
    return 0
  fi

  if [[ ! "$commit_sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "bazel-check: BuildBuddy metadata unavailable: tested commit is unavailable; omitting repository metadata" >&2
    return 0
  fi

  if ! snapshot="$(git_checkout_snapshot)"; then
    echo "bazel-check: BuildBuddy metadata unavailable: checkout changed while metadata was collected; omitting repository metadata" >&2
    return 0
  fi
  IFS=$'\t' read -r observed_branch_head observed_commit_sha <<<"$snapshot"
  if [ "$observed_branch_head" != "$branch_name" ] ||
    [ "$observed_commit_sha" != "$commit_sha" ]; then
    echo "bazel-check: BuildBuddy metadata unavailable: checkout changed while metadata was collected; omitting repository metadata" >&2
    return 0
  fi

  BUILD_BUDDY_METADATA_FLAGS=(
    "--build_metadata=REPO_URL=https://github.com/vicondoa/d2b"
    "--build_metadata=COMMIT_SHA=$commit_sha"
    "--build_metadata=BRANCH_NAME=$branch_name"
  )
}

trusted_context() {
  [ "${D2B_BAZEL_TRUSTED:-0}" = 1 ] &&
    [ "${GITHUB_REF:-}" = "refs/heads/v3" ] &&
    xtask bazel-evidence check-security >/dev/null
}

credential_helper() {
  local request token path
  request="$(cat)"
  if [[ "$request" != *'"uri"'* ]]; then
    printf '%s\n' '{"headers":{}}'
    return 0
  fi
  if [ "${D2B_BAZEL_UNTRUSTED:-0}" = 1 ] ||
    { [ "${GITHUB_ACTIONS:-false}" = true ] && ! trusted_context; }; then
    printf '%s\n' '{"headers":{}}'
    return 0
  fi

  if [ "${D2B_BAZEL_PROFILE:-}" = trusted-seed ]; then
    trusted_context || {
      printf '%s\n' '{"headers":{}}'
      return 0
    }
  fi

  path="$(credential_file)"
  if [ ! -r "$path" ] || [ ! -s "$path" ]; then
    printf '%s\n' '{"headers":{}}'
    return 0
  fi
  token="$(cat "$path")"
  case "$token" in
    *$'\n'*|*$'\r'*|'') printf '%s\n' '{"headers":{}}'; return 0 ;;
  esac

  # The value is carried on stdin to jq, never in an argument or diagnostic.
  printf '%s' "$token" |
    jq -Rs '{headers: {"x-buildbuddy-api-key": [rtrimstr("\n")]}}'
}

if [ -n "${D2B_XTASK_BIN:-}" ] &&
  [[ "$D2B_XTASK_BIN" != /* ]] &&
  [ -x "$D2B_XTASK_BIN" ]; then
  D2B_XTASK_BIN="$(cd -- "$(dirname -- "$D2B_XTASK_BIN")" && pwd)/$(basename -- "$D2B_XTASK_BIN")"
  export D2B_XTASK_BIN
fi

if [ "$#" -ge 1 ] && [ "$1" = get ]; then
  [ "$#" -eq 1 ] || {
    echo "credential helper get does not accept extra arguments" >&2
    exit 2
  }
  credential_helper
  exit $?
fi

cd "$ROOT"

if [ "$#" -eq 0 ]; then
  request="$(cat)"
  if [[ "$request" == *'"uri"'* ]]; then
    printf '%s' "$request" | credential_helper
    exit $?
  fi
  echo "usage: tests/tools/bazel-check --profile <local|remote|trusted-seed> -- <fixed Bazel target patterns...>" >&2
  exit 2
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile|--config)
      [ "$#" -ge 2 ] || { echo "$1 requires a value" >&2; exit 2; }
      PROFILE="$2"
      shift 2
      ;;
    --profile=*|--config=*)
      PROFILE="${1#*=}"
      shift
      ;;
    --)
      shift
      TARGETS=("$@")
      set --
      break
      ;;
    *)
      echo "unknown option $1" >&2
      exit 2
      ;;
  esac
done

if [ "${#TARGETS[@]}" -eq 0 ]; then
  echo "at least one fixed Bazel target pattern or label is required after --" >&2
  exit 2
fi

case "$PROFILE" in
  local|remote|trusted-seed) ;;
  *)
    echo "profile must be local, remote, or trusted-seed" >&2
    exit 2
    ;;
esac

if [ "${D2B_PROJECT_SHELL:-}" != d2b ]; then
  echo "bazel-check: D2B_PROJECT_SHELL=d2b is required; enter a d2b development shell" >&2
  exit "$CONFIGURATION_FAILURE_STATUS"
fi

bazel_bin="${D2B_BAZEL_BIN:-}"
if [ -z "$bazel_bin" ] || [ ! -x "$bazel_bin" ]; then
  echo "bazel-check: D2B_BAZEL_BIN must name the executable pinned by the d2b development shell" >&2
  exit "$CONFIGURATION_FAILURE_STATUS"
fi

mkdir -p "$SCRATCH_ROOT"
if ! (umask 077; mkdir "$SCRATCH"); then
  echo "bazel-check: cannot create isolated evidence directory" >&2
  exit 1
fi
export D2B_BAZEL_CHECK_SCRATCH="$SCRATCH"
if [ -z "${D2B_XTASK_BIN:-}" ] || [ ! -x "${D2B_XTASK_BIN}" ]; then
  bootstrap_log="$SCRATCH/bootstrap.log"
  if ! (umask 077; : >"$bootstrap_log") || ! chmod 0600 "$bootstrap_log"; then
    rm -f -- "$bootstrap_log"
    echo "bazel-check: cannot create protected xtask bootstrap log" >&2
    exit 1
  fi
  if ! "$bazel_bin" build --config=local //packages/xtask:xtask >"$bootstrap_log" 2>&1; then
    rm -f -- "$bootstrap_log"
    echo "bazel-check: xtask bootstrap failed" >&2
    exit 1
  fi
  bootstrap_warning_status=1
  warning_line_status "$bootstrap_log" || bootstrap_warning_status=$?
  if [ "$bootstrap_warning_status" -gt 1 ]; then
    rm -f -- "$bootstrap_log"
    echo "bazel-check: bootstrap warning scan failed; failing closed" >&2
    exit 1
  fi
  xtask_source="$ROOT/bazel-bin/packages/xtask/xtask"
  xtask_stable="$SCRATCH/xtask"
  if ! cp -L -- "$xtask_source" "$xtask_stable.tmp" ||
    ! chmod 0555 "$xtask_stable.tmp" ||
    ! mv -f -- "$xtask_stable.tmp" "$xtask_stable"; then
    rm -f -- "$bootstrap_log" "$xtask_stable.tmp"
    echo "bazel-check: xtask bootstrap artifact staging failed" >&2
    exit 1
  fi
  export D2B_XTASK_BIN="$xtask_stable"
  if ! redact_file "$bootstrap_log"; then
    rm -f -- "$bootstrap_log"
    echo "bazel-check: bootstrap evidence redaction failed; refusing to publish the run" >&2
    exit "$REDACTION_FAILURE_STATUS"
  fi
  redacted_bootstrap_warning_status=1
  warning_line_status "$bootstrap_log" || redacted_bootstrap_warning_status=$?
  if [ "$bootstrap_warning_status" -eq 0 ] ||
    [ "$redacted_bootstrap_warning_status" -eq 0 ]; then
    echo "bazel-check: bootstrap warning line found after log redaction; failing closed" >&2
    emit_captured_output "$bootstrap_log" "Bazel xtask bootstrap log"
    exit 1
  fi
  if [ "$redacted_bootstrap_warning_status" -gt 1 ]; then
    echo "bazel-check: bootstrap warning scan failed after log redaction; failing closed" >&2
    exit 1
  fi
fi

if [ "$PROFILE" = trusted-seed ]; then
  if ! trusted_context; then
    echo "trusted BuildBuddy credential withheld: protected v3 and security digest are required"
    PROFILE=local
  fi
elif [ "${D2B_BAZEL_UNTRUSTED:-0}" = 1 ] ||
  { [ "${GITHUB_ACTIONS:-false}" = true ] && ! trusted_context; }; then
  echo "BuildBuddy credential withheld for an untrusted job; retrying locally"
  PROFILE=local
elif [ ! -r "$(credential_file)" ] || [ ! -s "$(credential_file)" ]; then
  echo "BuildBuddy credential unavailable; retrying locally"
  PROFILE=local
fi

export D2B_BAZEL_BIN="$bazel_bin"
export D2B_REPO_ROOT="$ROOT"
export ROOT
JOB="${D2B_BAZEL_JOB:-check}"
log="$SCRATCH/$PROFILE.$JOB.log"
bep="$SCRATCH/$PROFILE.$JOB.bep.json"

bep_has_test_result() {
  local path="$1"
  [ -s "$path" ] &&
    jq -e -s 'any(.[]; .testResult != null)' "$path" >/dev/null 2>&1
}

run_bazel() {
  local profile="$1"
  local log_path="$2"
  local bep_path="$3"
  local -a startup_flags=()
  shift 3
  LAST_BAZEL_WARNING=0
  LAST_WARNING_SCAN_FAILURE=0
  if [ "${D2B_BAZEL_FALLBACK_ISOLATE_RC:-0}" = 1 ]; then
    [ ! -e "$ROOT/.bazelrc.user" ] || {
      echo "local fallback rejects an external workspace Bazel rc" >&2
      return "$CONFIGURATION_FAILURE_STATUS"
    }
    startup_flags=(--nosystem_rc --nohome_rc)
  fi
  set +e
  local tag_filters="${D2B_BAZEL_TEST_TAG_FILTERS:--manual,-gpu,-kvm}"
  local -a command_flags=()
  local test_bazel_sh="${BAZEL_SH:-/bin/bash}"
  local test_path="${D2B_BAZEL_TEST_PATH:-$PATH}"
  if [ "$profile" != local ]; then
    buildbuddy_metadata
    command_flags+=("${BUILD_BUDDY_METADATA_FLAGS[@]}")
    command_flags+=(--shell_executable=/bin/bash)
    test_bazel_sh=/bin/bash
    test_path="/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$test_path"
  fi
  D2B_BAZEL_PROFILE="$profile" "$bazel_bin" "${startup_flags[@]}" test "--config=$profile" \
    "${command_flags[@]}" \
    --repo_contents_cache= "--build_event_json_file=$bep_path" \
    --build_tests_only \
    --test_output=errors \
    --test_tag_filters="$tag_filters" \
    --test_env=D2B_REPO_ROOT="$ROOT" \
    --test_env=D2B_BAZEL_BIN="$bazel_bin" \
    --test_env=D2B_PROJECT_SHELL=d2b \
    --test_env=D2B_SHELLCHECK_BIN="${D2B_SHELLCHECK_BIN:-}" \
    --test_env=PATH="$test_path" \
    --test_env=BAZEL_SH="$test_bazel_sh" \
    "$@" \
    -- "${TARGETS[@]}" \
    >"$log_path" 2>&1
  local status=$?
  set -e
  local raw_warning_status=1
  warning_line_status "$log_path" || raw_warning_status=$?
  if [ "$raw_warning_status" -eq 0 ]; then
    LAST_BAZEL_WARNING=1
  elif [ "$raw_warning_status" -gt 1 ]; then
    LAST_WARNING_SCAN_FAILURE=1
  fi
  if [ "$status" -eq 0 ] && ! bep_has_test_result "$bep_path"; then
    echo "bazel-check: successful Bazel invocation emitted no testResult event" >&2
    status=1
  fi
  if ! redact_file "$log_path" || ! redact_file "$bep_path"; then
    echo "bazel-check: evidence redaction failed; refusing to publish the run" >&2
    emit_captured_metadata "$log_path" "bazel $profile log"
    emit_captured_metadata "$bep_path" "bazel $profile BEP"
    return "$REDACTION_FAILURE_STATUS"
  fi
  local redacted_warning_status=1
  warning_line_status "$log_path" || redacted_warning_status=$?
  if [ "$LAST_BAZEL_WARNING" -eq 1 ] || [ "$redacted_warning_status" -eq 0 ]; then
    echo "bazel-check: warning line found after log redaction; failing closed" >&2
    status=1
  elif [ "$LAST_WARNING_SCAN_FAILURE" -eq 1 ] || [ "$redacted_warning_status" -gt 1 ]; then
    echo "bazel-check: warning scan failed after log redaction; failing closed" >&2
    status=1
  fi
  return "$status"
}

initial_status=0
run_bazel "$PROFILE" "$log" "$bep" "$@" || initial_status=$?
initial_warning="$LAST_BAZEL_WARNING"
initial_warning_scan_failure="$LAST_WARNING_SCAN_FAILURE"
if [ "$initial_status" -eq 0 ]; then
  printf '%s\n' "bazel-check: $PROFILE passed"
  exit 0
fi
if [ "$initial_status" -eq "$REDACTION_FAILURE_STATUS" ] ||
  [ "$initial_status" -eq "$CONFIGURATION_FAILURE_STATUS" ]; then
  exit "$initial_status"
fi

if [ "$PROFILE" != local ]; then
  if [ "$initial_warning" -eq 1 ] || [ "$initial_warning_scan_failure" -eq 1 ]; then
    classification='{"kind":"warning","dispatchEvidence":false,"retryLocally":false,"maxLocalRetries":0}'
  else
    classification_args=(bazel-evidence classify-failure --log "$log")
    classification="$(xtask "${classification_args[@]}")"
  fi
  if printf '%s' "$classification" | jq -e '.retryLocally == true' >/dev/null; then
    local_log="$SCRATCH/local.$JOB.log"
    local_bep="$SCRATCH/local.$JOB.bep.json"
    echo "BuildBuddy failed; retrying the identical target set locally"
    local_status=0
    D2B_BAZEL_FALLBACK_ISOLATE_RC=1 \
      run_bazel local "$local_log" "$local_bep" "$@" || local_status=$?
    if [ "$local_status" -eq 0 ]; then
      printf '%s\n' "bazel-check: local fallback passed"
      exit 0
    fi
    if [ "$local_status" -eq "$REDACTION_FAILURE_STATUS" ] ||
      [ "$local_status" -eq "$CONFIGURATION_FAILURE_STATUS" ]; then
      exit "$local_status"
    fi
    printf '%s\n' "bazel-check: local fallback failed"
    emit_captured_output "$local_log" "bazel local fallback log"
    exit 1
  fi
  printf '%s\n' "$classification"
  printf '%s\n' "bazel-check: remote failure after dispatch or non-infrastructure failure; refusing local retry" >&2
  emit_captured_output "$log" "bazel $PROFILE log"
  exit 1
fi

printf '%s\n' "bazel-check: local execution failed" >&2
emit_captured_output "$log" "bazel local log"
exit 1
