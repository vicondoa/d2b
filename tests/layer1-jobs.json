{
  "version": 1,
  "local": {
    "defaultJobs": 4,
    "phases": [
      {
        "id": "preflight",
        "mode": "serial",
        "jobs": ["tier0", "check-inventory"]
      },
      {
        "id": "parallel",
        "mode": "parallel",
        "jobs": ["test-lint", "test-changelog", "test-rust", "test-proofs", "test-flake", "test-nix-unit", "test-policy"]
      },
      {
        "id": "serial-after-parallel",
        "mode": "serial",
        "jobs": ["test-drift", "test-runtime-ledger", "test-performance-budgets", "test-fixture-contracts"]
      }
    ]
  },
  "ci": {
    "workflowName": "pr-l1-static-fast",
    "jobs": [
      "tier0",
      "check-inventory",
      "test-performance-budgets",
      "test-lint",
      "test-changelog",
      "test-rust",
      "test-fixture-contracts",
      "test-proofs",
      "test-nix-unit",
      "flake-eval-discover",
      "flake-eval-x86",
      "flake-eval-x86-outputs",
      "test-flake-x86",
      "test-flake-aarch64",
      "test-drift",
      "test-policy",
      "test-runtime-ledger"
    ],
    "rollupJob": "check",
    "rollupNeeds": [
      "tier0",
      "check-inventory",
      "test-performance-budgets",
      "test-lint",
      "test-changelog",
      "test-rust",
      "test-fixture-contracts",
      "test-proofs",
      "test-nix-unit",
      "test-flake-x86",
      "test-flake-aarch64",
      "test-drift",
      "test-policy",
      "test-runtime-ledger"
    ],
    "allowedSkippedRollupJobs": ["test-changelog"]
  },
  "jobs": {
    "tier0": {
      "displayName": "Tier 0 first-pass gate",
      "makeTarget": "check-tier0",
      "extraMakeTargets": [
        { "makeTarget": "test-adr-index-coverage", "displayName": "ADR index coverage guard" },
        { "makeTarget": "test-ci-coverage", "displayName": "CI coverage structural guard" }
      ],
      "ciKind": "tier0",
      "ciJobId": "tier0",
      "timeoutMinutes": 5,
      "runsOn": "ubuntu-latest"
    },
    "check-inventory": {
      "displayName": "Migration ledger drift gate",
      "makeTarget": "check-inventory",
      "ciKind": "simple",
      "ciJobId": "check-inventory",
      "needs": ["tier0"],
      "timeoutMinutes": 5,
      "runsOn": "ubuntu-latest"
    },
    "test-performance-budgets": {
      "displayName": "Performance budget gate",
      "makeTarget": "test-performance-budgets",
      "enforcement": "advisory",
      "advisoryReason": "Latency budgets need a pinned self-hosted runner. Without D2B_PERF_STABLE=1 the gate skips, so it must not be counted as an enforcing green job.",
      "ciKind": "simple",
      "ciJobId": "test-performance-budgets",
      "needs": ["tier0"],
      "timeoutMinutes": 5,
      "runsOn": "ubuntu-latest"
    },
    "test-lint": {
      "displayName": "Lint gate (preflight + parse + shellcheck)",
      "makeTarget": "test-lint",
      "ciKind": "simple-nix",
      "ciJobId": "test-lint",
      "needs": ["tier0"],
      "timeoutMinutes": 10,
      "runsOn": "ubuntu-latest"
    },
    "test-changelog": {
      "displayName": "Changelog policy gate",
      "makeTarget": "test-changelog",
      "ciKind": "changelog",
      "ciJobId": "test-changelog",
      "needs": ["tier0"],
      "timeoutMinutes": 10,
      "runsOn": "ubuntu-latest"
    },
    "test-rust": {
      "displayName": "Rust workspace gate",
      "makeTarget": "test-rust",
      "localEnv": {
        "D2B_SKIP_FIXTURE_BUILD": "1"
      },
      "ciKind": "rust",
      "ciJobId": "test-rust",
      "needs": ["tier0"],
      "timeoutMinutes": 60,
      "runsOn": "ubuntu-latest"
    },
    "test-fixture-contracts": {
      "displayName": "Fixture-dependent Rust contract tests",
      "makeTarget": "test-fixture-contracts",
      "requiresHeavyGate": true,
      "localEnv": {
        "D2B_ENABLE_FIXTURE_BUILD": "1"
      },
      "ciEnv": {
        "D2B_ENABLE_FIXTURE_BUILD": "1"
      },
      "enforcesForSkip": "test-rust:D2B_SKIP_FIXTURE_BUILD",
      "ciKind": "rust",
      "ciJobId": "test-fixture-contracts",
      "needs": ["tier0"],
      "timeoutMinutes": 60,
      "runsOn": "ubuntu-latest"
    },
    "test-proofs": {
      "displayName": "Proof crates gate",
      "makeTarget": "test-proofs",
      "ciKind": "simple-nix",
      "ciJobId": "test-proofs",
      "needs": ["tier0"],
      "timeoutMinutes": 15,
      "runsOn": "ubuntu-latest"
    },
    "test-flake": {
      "displayName": "Local sharded flake gate",
      "makeTarget": "test-flake",
      "localEnv": {
        "D2B_FLAKE_LOCAL_SHARDS": "1"
      }
    },
    "test-nix-unit": {
      "displayName": "Nix unit corpus gate",
      "makeTarget": "test-nix-unit",
      "ciKind": "simple-nix",
      "ciJobId": "test-nix-unit",
      "needs": ["tier0"],
      "timeoutMinutes": 30,
      "runsOn": "ubuntu-latest"
    },
    "flake-eval-discover": {
      "displayName": "Enumerate flake checks (x86_64-linux)",
      "ciKind": "flake-discover",
      "ciJobId": "flake-eval-discover",
      "needs": ["tier0"],
      "timeoutMinutes": 10,
      "runsOn": "ubuntu-latest"
    },
    "flake-eval-x86": {
      "displayName": "Flake check shard (x86_64-linux)",
      "ciKind": "flake-x86-shards",
      "ciJobId": "flake-eval-x86",
      "needs": ["flake-eval-discover"],
      "timeoutMinutes": 60,
      "runsOn": "ubuntu-latest",
      "maxParallel": 4
    },
    "flake-eval-x86-outputs": {
      "displayName": "Flake non-checks outputs (x86_64-linux)",
      "ciKind": "flake-x86-outputs",
      "ciJobId": "flake-eval-x86-outputs",
      "needs": ["tier0"],
      "timeoutMinutes": 20,
      "runsOn": "ubuntu-latest"
    },
    "test-flake-x86": {
      "displayName": "Require all x86 flake jobs to pass",
      "ciKind": "flake-x86-rollup",
      "ciJobId": "test-flake-x86",
      "needs": ["flake-eval-discover", "flake-eval-x86", "flake-eval-x86-outputs"],
      "timeoutMinutes": 5,
      "runsOn": "ubuntu-latest"
    },
    "test-flake-aarch64": {
      "displayName": "aarch64 smoke eval",
      "ciKind": "flake-aarch64-smoke",
      "ciJobId": "test-flake-aarch64",
      "needs": ["tier0"],
      "timeoutMinutes": 15,
      "runsOn": "ubuntu-latest"
    },
    "test-drift": {
      "displayName": "Drift gate",
      "makeTarget": "test-drift",
      "ciKind": "simple-nix",
      "ciJobId": "test-drift",
      "needs": ["tier0"],
      "timeoutMinutes": 15,
      "runsOn": "ubuntu-latest"
    },
    "test-policy": {
      "displayName": "Policy meta-gates",
      "makeTarget": "test-policy",
      "ciKind": "rust",
      "ciJobId": "test-policy",
      "needs": ["tier0"],
      "timeoutMinutes": 60,
      "runsOn": "ubuntu-latest"
    },
    "test-runtime-ledger": {
      "displayName": "Runtime execution-budget ledger gate",
      "makeTarget": "test-runtime-ledger",
      "ciKind": "rust",
      "ciJobId": "test-runtime-ledger",
      "needs": ["tier0"],
      "timeoutMinutes": 30,
      "runsOn": "ubuntu-latest"
    }
  }
}
