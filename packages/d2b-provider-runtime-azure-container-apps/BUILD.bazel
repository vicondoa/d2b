load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_runtime_azure_container_apps",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-realm-core:d2b_realm_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_runtime_azure_container_apps_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_runtime_azure_container_apps",
    deps = [
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-realm-core:d2b_realm_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "scaffold",
    srcs = ["tests/scaffold.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)


rust_test(
    name = "provider_lifecycle",
    srcs = [
        "tests/provider_lifecycle.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_runtime_azure_container_apps",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_runtime_azure_container_apps_doc_test",
    crate = "//packages/d2b-provider-runtime-azure-container-apps:d2b_provider_runtime_azure_container_apps",
)
