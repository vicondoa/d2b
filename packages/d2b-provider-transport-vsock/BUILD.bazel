load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_transport_vsock",
    srcs = [
        "src/audit.rs",
        "src/auth.rs",
        "src/bridge.rs",
        "src/effect_port.rs",
        "src/errors.rs",
        "src/framing.rs",
        "src/lib.rs",
        "src/limits.rs",
        "src/metrics.rs",
        "src/relay.rs",
        "src/service.rs",
        "src/settings.rs",
        "src/state_volume.rs",
        "src/topology.rs",
    ],
    compile_data = [
        "Cargo.toml",
        "//:docs/reference/schemas/v3/providers/transport-vsock.transport-binding.json",  # keep
    ],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider:d2b_provider",
        "//packages/d2b-session:d2b_session",
        "@crates//:ring",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "scaffold",
    srcs = ["tests/scaffold.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
