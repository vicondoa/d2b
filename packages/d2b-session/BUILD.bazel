load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_session_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_session",
    srcs = d2b_session_srcs,
    compile_data = ["Cargo.toml"],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-audit:d2b_audit",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-resource-api:d2b_resource_api",
        "//packages/d2b-telemetry:d2b_telemetry",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_session_test_support",
    srcs = d2b_session_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_session",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-audit:d2b_audit_test_support",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-resource-api:d2b_resource_api_test_support",
        "//packages/d2b-telemetry:d2b_telemetry_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "admission",
    srcs = ["tests/admission.rs"],
    compile_data = ["Cargo.toml"],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_session",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-resource-api:d2b_resource_api",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "component_session",
    srcs = ["tests/component_session.rs"],
    compile_data = ["Cargo.toml"],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_session",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "noise_vectors",
    srcs = ["tests/noise_vectors.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_session",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_session_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_session",
    deps = [
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_session_doc_test",
    crate = "//packages/d2b-session:d2b_session",
)
