load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    [
        "BUILD.bazel",
        "src/host_validate.rs",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_lib",
    srcs = [
        "src/activation.rs",
        "src/complete.rs",
        "src/context.rs",
        "src/dispatch.rs",
        "src/doctor.rs",
        "src/endpoint.rs",
        "src/exec.rs",
        "src/exec_client.rs",
        "src/guest.rs",
        "src/host.rs",
        "src/host_validate.rs",
        "src/legacy.rs",
        "src/lib.rs",
        "src/provider.rs",
        "src/resource.rs",
        "src/share.rs",
        "src/shell.rs",
        "src/status_read_model.rs",
        "src/target_routing.rs",
        "src/terminal_client.rs",
        "src/zone.rs",
        "src/zone_audit.rs",
        "src/zone_doctor.rs",
        "src/zone_support_bundle.rs",
    ],
    compile_data = [
        "Cargo.toml",
        "src/legacy.rs",
        "src/lib.rs",
    ],
    crate_name = "d2b",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-realm-core:d2b_realm_core",
        "//packages/d2b-realm-router:d2b_realm_router",
        "//packages/d2b-resource-client:d2b_resource_client",
        "@crates//:clap",
        "@crates//:nix",
        "@crates//:rustix",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_binary(
    name = "d2b",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":d2b_lib"],
)

