    name = "audit_contract",
    srcs = [
        "tests/audit_contract.rs",
        "tests/common/mod.rs",
    ],
    compile_data = ["Cargo.toml"],
    crate_root = "tests/audit_contract.rs",
    data = [":d2b"],
    env = {"CARGO_BIN_EXE_d2b": "$(rootpath :d2b)"},
    rustc_env = {"CARGO_BIN_EXE_d2b": "$(rootpath :d2b)"},
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
