load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = [])

exports_files(
    [
        "BUILD.bazel",
        "Cargo.toml",
    ],
    visibility = ["//visibility:public"],
)

d2b_rust_binary(
    name = "d2b-provider-test-controller",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-session:d2b_session",
        "//packages/d2b-session-unix:d2b_session_unix",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "unit",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-session:d2b_session",
        "//packages/d2b-session-unix:d2b_session_unix",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "controller",
    srcs = ["tests/controller.rs"],
    compile_data = ["Cargo.toml"],
    args = ["$(rootpath :d2b-provider-test-controller)"],
    data = [":d2b-provider-test-controller"],
    deps = [
        ":d2b-provider-test-controller",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
