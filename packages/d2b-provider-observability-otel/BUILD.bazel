load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    [
        "BUILD.bazel",
        "README.md",
        "src/nix/journald.nix",
        "nix/default.nix",
        "nix/guest.nix",
        "nix/host.nix",
        "nix/projection.nix",
        "nix/stack.nix",
        "nix/tests/default.nix",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_observability_otel",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "ingress_metric_policy",
    srcs = ["tests/ingress_metric_policy.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":d2b_provider_observability_otel",
            "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session", ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "binding_controller",
    srcs = ["tests/binding_controller.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_provider_observability_otel",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_provider_observability_otel_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_observability_otel",
    deps = ["//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",  "//packages/d2b-contracts-provider:d2b_contracts_provider",] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.nix",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_observability_otel_doc_test",
    crate = "//packages/d2b-provider-observability-otel:d2b_provider_observability_otel",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
