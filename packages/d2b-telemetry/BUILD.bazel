load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_telemetry_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_telemetry",
    srcs = d2b_telemetry_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts",

    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_telemetry_test_support",
    srcs = d2b_telemetry_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_telemetry",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts_test_support",

    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_telemetry_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_telemetry",
    tags = ["no-remote-cache"],
    deps = ["//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",  "//packages/d2b-contracts-provider:d2b_contracts_provider",] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_telemetry_doc_test",
    crate = "//packages/d2b-telemetry:d2b_telemetry",
)
