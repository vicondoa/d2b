load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-network-local:__pkg__", "//packages/d2bd:__pkg__", "//packages/xtask:__pkg__"])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_guest",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2bd-runtime:d2bd_runtime",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        "//packages/d2b-provider-guest-azure-container-apps:d2b_provider_guest_azure_container_apps",
        "//packages/d2b-provider-guest-azure-virtual-machine:d2b_provider_guest_azure_virtual_machine",
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor",
        "//packages/d2b-provider-guest-qemu-media:d2b_provider_guest_qemu_media",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_guest_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_guest",
    deps = [
        "//packages/d2bd-runtime:d2bd_runtime_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-provider-guest-azure-container-apps:d2b_provider_guest_azure_container_apps_test_support",
        "//packages/d2b-provider-guest-azure-virtual-machine:d2b_provider_guest_azure_virtual_machine_test_support",
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor_test_support",
        "//packages/d2b-provider-guest-qemu-media:d2b_provider_guest_qemu_media_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_guest_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_guest",
)

d2b_rust_test(
    name = "registration",
    srcs = ["tests/registration.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2bd-runtime:d2bd_runtime_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-provider-guest-azure-container-apps:d2b_provider_guest_azure_container_apps_test_support",
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
        ":d2b_provider_guest_test_support",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_guest_doc_test",
    crate = "//packages/d2b-provider-guest:d2b_provider_guest",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
