load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_resource_types",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
    ] + all_crate_deps(normal = True, cargo_only = True),
)
d2b_rust_library(
    name = "d2b_resource_types_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    visibility = ["//visibility:public"],
    crate_name = "d2b_resource_types",
    deps = [
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
    ] + all_crate_deps(normal = True, cargo_only = True),
)


d2b_rust_test(
    name = "d2b_resource_types_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_types",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_resource_types_doc_test",
    crate = "//packages/d2b-resource-types:d2b_resource_types",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
