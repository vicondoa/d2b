load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "d2b-sk-frontend",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    crate_root = "src/main.rs",
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b-sk-frontend_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b-sk-frontend",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
