# The Nix inventory generator renders the process family's role-to-provider
# map and `ProcessRole` vocabulary from the crate's `resource-types.json`
# declaration (U4), and the role parity surface is the declaring crate's
# descriptor sources plus the well-known type vocabulary they name, so the
# drift target reads the declaration and those sources beside the artifacts
# it compares.
generated_artifact_check(
    name = "gen_nix_inventories_drift",
    command = "gen-nix-inventories",
    data = [
        "//:committed_v3_schema_artifacts",
        "//:docs/reference/policy/principal-allocation.json",
        "//:generated_nix_inventories",
        "//packages/d2b-provider-process:cargo_workspace_sources",
        "//packages/d2b-provider-process:resource-types.json",
        "//packages/d2b-resource-types:cargo_workspace_sources",
    ],
)

# The policy-inputs bundle is projected from the locked Cargo metadata, so its
# drift target needs the lock, the workspace sources, the protected ownership
# declaration the advisory policy is validated against, and the bundle it
# rewrites.
#
# The generator shells out to `cargo metadata --locked --offline`, so the run
# also needs the invoking environment: cargo on `PATH`, and the caller's
# `CARGO_HOME`/`RUSTUP_HOME` caches warm enough to resolve the locked git
# dependencies offline. A sandboxed test with an isolated home fails before it
# compares anything. The local profile supplies `PATH`; under the remote
# profile the fixed `--test_env=PATH` wins, so run the gate through a profile
# that carries the toolchain.
generated_artifact_check(
    name = "gen_package_policy_inputs_drift",
    command = "gen-package-policy-inputs",
    data = [
        "//:.github/CODEOWNERS",
        "//:Cargo.lock",
        "//:packages_workspace_sources",
        "//:policy_inputs_workspace_sources",
    ],
    env_inherit = ["HOME", "CARGO_HOME", "RUSTUP_HOME", "PATH"],
)

generated_artifact_generator(
    name = "generate",
    data = [
        "//:docs_workspace_sources",
        "//:nixos_modules_workspace_sources",
        "//:packages_workspace_sources",
        "//:policy_inputs_workspace_sources",
    ],
)

