load("@crates//:defs.bzl", "all_crate_deps")
load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy_test",
    "rust_test",
    "rustfmt_test",
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "manifest_v04_check",
    srcs = ["src/bin/manifest_v04_check.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = ["//packages/d2b-core:d2b_core"] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "xtask",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    crate_root = "src/main.rs",
    compile_data = [
        "Cargo.toml",
        "src/heavy_gate.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b:d2b_lib",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-realm-core:d2b_realm_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "bazel_compatibility",
    timeout = "long",
    srcs = ["tests/bazel_compatibility.rs"],
    compile_data = ["Cargo.toml"],
    data = [
        "//bazel/checks/rust:repo_policy_sources",
        "//tests/fixtures/gas-city/buildbuddy:BUILD.bazel",
    ],
    env_inherit = [
        "BAZEL_SH",
        "D2B_REPO_ROOT",
        "PATH",
        "D2B_BAZEL_BIN",
        "D2B_BAZEL_TEST_PATH",
    ],
    tags = ["local"],
    visibility = ["//visibility:public"],
    deps = [] + all_crate_deps(normal_dev = True, cargo_only = True),
)

