rust_test(
    name = "bazel_compatibility",
    timeout = "long",
    srcs = ["tests/bazel_compatibility.rs"],
    compile_data = ["Cargo.toml"],
    data = [
        ":xtask",
        "//bazel/checks/rust:repo_policy_sources",
        "//tests/fixtures/gas-city/buildbuddy:BUILD.bazel",
    ],
    env = {"CARGO_BIN_EXE_xtask": "$(rootpath :xtask)"},
    env_inherit = [
        "BAZEL_SH",
        "PATH",
        "D2B_BAZEL_BIN",
        "D2B_BAZEL_TEST_PATH",
    ],
    rustc_env = {"CARGO_BIN_EXE_xtask": "$(rootpath :xtask)"},
    visibility = ["//visibility:public"],
    deps = ["@crates//:serde_json"],
)

