load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "d2b_zone_routing",
    srcs = [
        "src/engine.rs",
        "src/lib.rs",
        "src/resolver.rs",
        "src/router.rs",
        "src/service.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = ["//packages/d2b-contracts:d2b_contracts"],
)

rust_test(
    name = "route_engine_vectors",
