load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_zone_routing_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_zone_routing",
    srcs = d2b_zone_routing_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = ["//packages/d2b-contracts:d2b_contracts"] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_zone_routing_test_support",
    srcs = d2b_zone_routing_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_zone_routing",
    visibility = ["//visibility:public"],
    deps = ["//packages/d2b-contracts:d2b_contracts_test_support"] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "route_engine_vectors",
    srcs = ["tests/route_engine_vectors.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_zone_routing",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_binary(
    name = "route_decision",
    srcs = ["benches/route_decision.rs"],
    compile_data = ["Cargo.toml"],
    tags = ["bench"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_zone_routing",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_zone_routing_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_zone_routing",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
