    visibility = ["//visibility:public"],
    deps = [
        ":d2b_zone_routing",
        "//packages/d2b-contracts:d2b_contracts",
    ],
)

rust_binary(
    name = "route_decision",
    srcs = ["benches/route_decision.rs"],
    compile_data = ["Cargo.toml"],
    tags = ["bench"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_zone_routing",
        "//packages/d2b-contracts:d2b_contracts",
    ],
)

rust_test(
    name = "d2b_zone_routing_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_zone_routing",
)
