load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_zone_routing_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_zone_routing",
    srcs = d2b_zone_routing_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-bus:d2b_bus",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_zone_routing_test_support",
    srcs = d2b_zone_routing_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_zone_routing",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-bus:d2b_bus_test_support",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "route_engine_vectors",
    srcs = ["tests/route_engine_vectors.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_zone_routing_test_support",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "route_decision",
    srcs = ["benches/route_decision.rs"],
    compile_data = ["Cargo.toml"],
    tags = ["bench"],
    use_libtest_harness = False,
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_zone_routing_test_support",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_zone_routing_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_zone_routing",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_zone_routing_doc_test",
    crate = "//packages/d2b-zone-routing:d2b_zone_routing",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
