load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_audit_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_audit",
    srcs = d2b_audit_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-telemetry:d2b_telemetry",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_audit_test_support",
    srcs = d2b_audit_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_audit",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-telemetry:d2b_telemetry_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_audit_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_audit",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
