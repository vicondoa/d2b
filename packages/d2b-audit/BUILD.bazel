load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_audit_srcs = glob(["src/**/*.rs"], allow_empty = True)

# The generated record catalog the crate validates against;
# `gen-layer-catalogs` writes it and
# `//packages/xtask:gen_layer_catalogs_drift` compares it byte-for-byte.
filegroup(
    name = "generated_audit_catalog",
    srcs = glob(["src/generated/*.rs"]),
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_audit",
    srcs = d2b_audit_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-telemetry:d2b_telemetry",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_audit_test_support",
    srcs = d2b_audit_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_audit",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-telemetry:d2b_telemetry_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_audit_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_audit",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_audit_doc_test",
    crate = "//packages/d2b-audit:d2b_audit",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
