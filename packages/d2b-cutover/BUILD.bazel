load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_cutover",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "d2b-cutover-runner",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    crate_root = "src/bin/d2b-cutover-runner.rs",
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_cutover",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "crash_recovery",
    srcs = ["tests/crash_recovery.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_cutover",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "reset_scope",
    srcs = ["tests/reset_scope.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_cutover",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "runner_contract",
    srcs = ["tests/runner_contract.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_cutover",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "state_machine",
    srcs = ["tests/state_machine.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_cutover",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_cutover_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_cutover",
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b-cutover-runner_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b-cutover-runner",
    data = [":d2b-cutover-runner"],
    env = {"CARGO_BIN_EXE_d2b-cutover-runner": "$(rootpath :d2b-cutover-runner)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-cutover-runner": "$(rootpath :d2b-cutover-runner)"},
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
