load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "guest_ttrpc_generated",
    srcs = ["src/generated/guest_control_ttrpc.rs"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_guestd",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-exec-runner:d2b_exec_runner",
        "//packages/d2b-realm-core:d2b_realm_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "d2b-guestd",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_guestd",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "fail_closed",
    srcs = ["tests/fail_closed.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-guestd"],
    env = {"CARGO_BIN_EXE_d2b-guestd": "$(rootpath :d2b-guestd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-guestd": "$(rootpath :d2b-guestd)"},
    visibility = ["//visibility:public"],
)

rust_test(
    name = "d2b_guestd_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_guestd",
    tags = ["no-remote-cache"],
    data = [":d2b-guestd"],
    env = {"CARGO_BIN_EXE_d2b-guestd": "$(rootpath :d2b-guestd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-guestd": "$(rootpath :d2b-guestd)"},
    deps = ["//packages/d2b-exec-runner:d2b_exec_runner"] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_guestd_doc_test",
    crate = "//packages/d2b-guestd:d2b_guestd",
)
