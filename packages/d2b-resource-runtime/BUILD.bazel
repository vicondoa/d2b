load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//visibility:public"])

# keep

d2b_resource_runtime_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_resource_runtime",
    srcs = d2b_resource_runtime_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_resource_runtime_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_runtime",
    data = ["//:docs/reference/resource-runtime-failure-kinds.md"],
    deps = all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob([
        "Cargo.lock",
        "Cargo.toml",
        "benches/**/*.rs",
        "build.rs",
        "examples/**/*.rs",
        "src/**/*.rs",
        "tests/**/*.rs",
    ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
