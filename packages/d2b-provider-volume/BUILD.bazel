load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2bd:__pkg__"])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_volume",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-provider-volume-local:d2b_provider_volume_local",
        "//packages/d2b-provider-volume-virtiofs:d2b_provider_volume_virtiofs",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_provider_volume_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_volume",
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-provider-volume-local:d2b_provider_volume_local_test_support",
        "//packages/d2b-provider-volume-virtiofs:d2b_provider_volume_virtiofs",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "registration",
    srcs = ["tests/registration.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        ":d2b_provider_volume",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_volume_doc_test",
    crate = "//packages/d2b-provider-volume:d2b_provider_volume",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
