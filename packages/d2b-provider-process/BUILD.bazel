load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-supervisor:__pkg__", "//packages/d2bd:__pkg__"])


exports_files(
    [
        "BUILD.bazel",
        # The operation-row declaration the broker-operation generator and
        # its drift target read (U2/KTD3).
        "operations.json",
        # The provider-facts declaration the resource-type authority and the
        # Nix inventory drift target read (U4).
        "resource-types.json",
    ],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_process",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
        # The include_str! fixtures this crate's test-support code loads.
        "//tests/fixtures:deny-unknown/host-valid.json",
        "//:tests/golden/manifest_v04/baseline-vms.json",
    ],
    deps = [
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-process-conformance:d2b_process_conformance",
        "//packages/d2b-provider-process-minijail:d2b_provider_process_minijail",
        "//packages/d2b-provider-process-systemd:d2b_provider_process_systemd",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        "//packages/d2b-provider-volume-virtiofs:d2b_provider_volume_virtiofs",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_process_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
        # The include_str! fixtures this crate's test-support code loads.
        "//tests/fixtures:deny-unknown/host-valid.json",
        "//:tests/golden/manifest_v04/baseline-vms.json",
    ],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_process",
    deps = [
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor_test_support",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-process-conformance:d2b_process_conformance_test_support",
        "//packages/d2b-provider-process-minijail:d2b_provider_process_minijail_test_support",
        "//packages/d2b-provider-process-systemd:d2b_provider_process_systemd_test_support",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-provider-volume-virtiofs:d2b_provider_volume_virtiofs",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_process_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_process_test_support",
)

d2b_rust_test(
    name = "process_family",
    srcs = ["tests/process_family.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor",
        ":d2b_provider_process",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-process-conformance:d2b_process_conformance",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_process_doc_test",
    crate = "//packages/d2b-provider-process:d2b_provider_process",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
