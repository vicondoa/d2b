load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_runtime_azure_virtual_machine",
    srcs = [
        "src/audit.rs",
        "src/bootstrap.rs",
        "src/bootstrap_svc.rs",
        "src/config.rs",
        "src/controller/mod.rs",
        "src/effect/mod.rs",
        "src/error.rs",
        "src/idempotency.rs",
        "src/lib.rs",
        "src/telemetry.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "@crates//:base64",
        "//packages/d2b-contracts:d2b_contracts",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:zeroize",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "scaffold",
    srcs = ["tests/scaffold.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
