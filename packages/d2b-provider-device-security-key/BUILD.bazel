load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_device_security_key",
    srcs = [
        "src/authority.rs",
        "src/cid.rs",
        "src/controller.rs",
        "src/descriptor.rs",
        "src/lease.rs",
        "src/lib.rs",
        "src/process.rs",
        "src/session_ring.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "@crates//:serde",
    ],
)

