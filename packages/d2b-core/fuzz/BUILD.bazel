load("@rules_rust//rust:defs.bzl", "rust_binary")

exports_files(
    ["BUILD.bazel", "Cargo.toml"],
    visibility = ["//visibility:public"],
)

# keep
# gazelle:ignore

exports_files([
    "Cargo.toml",
    "src/bin/bundle.rs",
    "src/bin/core.rs",
    "src/bin/host.rs",
    "src/bin/manifest.rs",
    "src/bin/privileges.rs",
    "src/harness.rs",
], visibility = ["//visibility:public"])

filegroup(
    name = "workspace_sources",
    srcs = ["BUILD.bazel", "Cargo.toml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "corpus",
    srcs = glob(["corpus/**/*"], allow_empty = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "bundle",
    srcs = [
        "src/bin/bundle.rs",
        "src/harness.rs",  # keep
    ],
    compile_data = ["Cargo.toml"],
    crate_features = ["fuzz"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "@bazel_only_crates//:bolero",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "core",
    srcs = [
        "src/bin/core.rs",
        "src/harness.rs",  # keep
    ],
    compile_data = [
        "//:tests/golden/vms.json-signoz-v7",  # keep
        "Cargo.toml",
    ],
    crate_features = ["fuzz"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "@bazel_only_crates//:bolero",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "host",
    srcs = [
        "src/bin/host.rs",
        "src/harness.rs",  # keep
    ],
    compile_data = ["Cargo.toml"],
    crate_features = ["fuzz"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "@bazel_only_crates//:bolero",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "manifest",
    srcs = [
        "src/bin/manifest.rs",
        "src/harness.rs",  # keep
    ],
    compile_data = ["Cargo.toml"],
    crate_features = ["fuzz"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "@bazel_only_crates//:bolero",
    ],
)

rust_binary(
    name = "privileges",
    srcs = [
        "src/bin/privileges.rs",
        "src/harness.rs",  # keep
    ],
    compile_data = ["Cargo.toml"],
    crate_features = ["fuzz"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "@bazel_only_crates//:bolero",
        "@crates//:serde_json",
    ],
)
