load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
        "src/mutation_seal.rs",
    ],
    visibility = ["//visibility:public"],
)

d2b_resource_store_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_resource_store",
    srcs = d2b_resource_store_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = ["//packages/d2b-contracts-resource:d2b_contracts_resource"] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_resource_store_test_support",
    srcs = d2b_resource_store_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_resource_store",
    visibility = ["//visibility:public"],
    deps = ["//packages/d2b-contracts-resource:d2b_contracts_resource"] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_resource_store_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_store",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_resource_store_doc_test",
    crate = "//packages/d2b-resource-store:d2b_resource_store",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
