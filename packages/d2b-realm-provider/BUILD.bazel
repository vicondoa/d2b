load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_realm_provider",
    srcs = [
        "src/capabilities.rs",
        "src/conformance.rs",
        "src/credential.rs",
        "src/error.rs",
        "src/lib.rs",
        "src/mock.rs",
        "src/provider.rs",
        "src/rate_limit.rs",
        "src/types.rs",
    ],
    compile_data = ["Cargo.toml"],
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-realm-core:d2b_realm_core",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "d2b_realm_provider_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_realm_provider",
    deps = [
        "//packages/d2b-realm-core:d2b_realm_core",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
