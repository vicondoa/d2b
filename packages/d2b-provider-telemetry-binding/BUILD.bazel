load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_telemetry_binding",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-provider-observability-otel:d2b_provider_observability_otel",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

d2b_rust_test(
    name = "registration",
    srcs = ["tests/registration.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        ":d2b_provider_telemetry_binding",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_telemetry_binding_doc_test",
    crate = "//packages/d2b-provider-telemetry-binding:d2b_provider_telemetry_binding",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
