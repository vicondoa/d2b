load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# gazelle:ignore

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_resource_client",
    srcs = [
        "src/call.rs",
        "src/client.rs",
        "src/dispatch.rs",
        "src/error.rs",
        "src/lib.rs",
        "src/process_attach.rs",
        "src/target.rs",
        "src/zone_client.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "d2b_resource_client_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_client",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
