load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-guest:__pkg__", "//packages/d2bd:__pkg__"])

exports_files(
    ["BUILD.bazel", "nix/default.nix", "nix/tests/default.nix"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_guest_azure_virtual_machine",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)
d2b_rust_library(
    name = "d2b_provider_guest_azure_virtual_machine_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_guest_azure_virtual_machine",
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)


d2b_rust_test(
    name = "bootstrap_hermetic",
    srcs = [
        "tests/bootstrap_hermetic.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_guest_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "error_redaction",
    srcs = [
        "tests/error_redaction.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_guest_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)
d2b_rust_test(
    name = "recovery_decode",
    srcs = [
        "tests/recovery_decode.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_guest_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)


d2b_rust_test(
    name = "lifecycle_hermetic",
    srcs = [
        "tests/lifecycle_hermetic.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        ":d2b_provider_guest_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_guest_azure_virtual_machine_doc_test",
    crate = "//packages/d2b-provider-guest-azure-virtual-machine:d2b_provider_guest_azure_virtual_machine",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
