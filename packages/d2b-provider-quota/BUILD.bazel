load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2bd:__pkg__",
    "//packages/d2b-resource-api:__pkg__"])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_quota",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",] + all_crate_deps(normal = True, cargo_only = True),
)
d2b_rust_library(
    name = "d2b_provider_quota_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_quota",
    deps = [
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
)


d2b_rust_test(
    name = "registration",
    srcs = ["tests/registration.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
        ":d2b_provider_quota_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_quota_doc_test",
    crate = "//packages/d2b-provider-quota:d2b_provider_quota",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
