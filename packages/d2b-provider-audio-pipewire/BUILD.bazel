# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_audio_pipewire_doc_test",
    crate = "//packages/d2b-provider-audio-pipewire:d2b_provider_audio_pipewire",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
