load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-audio-binding:__pkg__", "//packages/d2b-provider-audio-service:__pkg__", "//packages/d2b-provider-wayland-policy:__pkg__", "//packages/d2bd:__pkg__"])

exports_files(
    [
        "BUILD.bazel",
        "nix/default.nix",
        "nix/projection.nix",
        "nix/tests/default.nix",
    ],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_audio_pipewire",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_audio_pipewire_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_audio_pipewire",
    deps = [
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "audio_policy",
    srcs = [
        "tests/audio_policy.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_provider_audio_pipewire",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "state",
    srcs = ["tests/state.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_provider_audio_pipewire",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "authority",
    srcs = [
        "tests/authority.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_provider_audio_pipewire",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
