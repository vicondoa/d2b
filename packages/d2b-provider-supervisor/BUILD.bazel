load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_supervisor",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "//packages/d2b-broker:src/live_handlers.rs",  # keep
        "//packages/d2b-broker:src/runtime.rs",  # keep
        "Cargo.toml",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-process:d2b_process",
        "//packages/d2b-telemetry:d2b_telemetry",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-process-conformance:d2b_process_conformance",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_provider_supervisor_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "//packages/d2b-broker:src/live_handlers.rs",  # keep
        "//packages/d2b-broker:src/runtime.rs",  # keep
        "Cargo.toml",
    ],
    crate_name = "d2b_provider_supervisor",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-process:d2b_process_test_support",
        "//packages/d2b-telemetry:d2b_telemetry_test_support",
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-process-conformance:d2b_process_conformance_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "production_adapter",
    srcs = ["tests/production_adapter.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_supervisor",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-process:d2b_process",
        "//packages/d2b-process-conformance:d2b_process_conformance",
        "//packages/d2b-provider-system-minijail:d2b_provider_system_minijail",
        "//packages/d2b-provider-system-systemd:d2b_provider_system_systemd",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_provider_supervisor_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_supervisor",
    deps = ["//packages/d2b-process-conformance:d2b_process_conformance",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session", ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_supervisor_doc_test",
    crate = "//packages/d2b-provider-supervisor:d2b_provider_supervisor",
)
