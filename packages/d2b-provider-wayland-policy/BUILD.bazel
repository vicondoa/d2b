load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-audio-binding:__pkg__", "//packages/d2b-provider-audio-service:__pkg__", "//packages/d2b-provider-shell-pool:__pkg__", "//packages/d2b-provider-shell-session:__pkg__", "//packages/d2b-provider-wayland-session:__pkg__", "//packages/d2bd:__pkg__"])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_wayland_policy",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-provider-audio-pipewire:d2b_provider_audio_pipewire",
        "//packages/d2b-provider-display-wayland:d2b_provider_display_wayland",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        "//packages/d2b-resource-api:d2b_resource_api",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_wayland_policy_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_wayland_policy",
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core-controller:d2b_core_controller_test_support",
        "//packages/d2b-provider-audio-pipewire:d2b_provider_audio_pipewire_test_support",
        "//packages/d2b-provider-display-wayland:d2b_provider_display_wayland_test_support",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-resource-api:d2b_resource_api_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "registration",
    srcs = ["tests/registration.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_wayland_policy_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "engine",
    srcs = ["tests/engine.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_wayland_policy_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_wayland_policy_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_wayland_policy",
    deps = all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_wayland_policy_doc_test",
    crate = "//packages/d2b-provider-wayland-policy:d2b_provider_wayland_policy",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
