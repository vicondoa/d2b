load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_clipd",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-realm-core:d2b_realm_core",

    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "d2b-clip-debug",
    srcs = ["src/bin/d2b-clip-debug.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "d2b-clipd",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_clipd",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-realm-core:d2b_realm_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "daemon_cli",
    srcs = ["tests/daemon_cli.rs"],
    compile_data = [
        "Cargo.toml",
        "src/main.rs",
    ],
    data = [":d2b-clipd"],
    env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    visibility = ["//visibility:public"],
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "test_pipe",
    srcs = ["tests/test_pipe.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-clipd"],
    env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    visibility = ["//visibility:public"],
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_clipd_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_clipd",
    data = [":d2b-clipd"],
    env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b-clip-debug_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b-clip-debug",
    data = [":d2b-clipd"],
    env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
)

rust_test(
    name = "d2b-clipd_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b-clipd",
    data = [":d2b-clipd"],
    env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_clipd_doc_test",
    crate = "//packages/d2b-clipd:d2b_clipd",
)
