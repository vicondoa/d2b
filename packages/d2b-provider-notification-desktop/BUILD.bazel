load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_notification_desktop",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "scaffold",
    srcs = ["tests/scaffold.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)


