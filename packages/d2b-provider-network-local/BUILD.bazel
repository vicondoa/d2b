load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2bd:__pkg__"])


exports_files(
    [
        "BUILD.bazel",
        "nix/artifacts.nix",
        "nix/default.nix",
        "nix/net-mdns.nix",
        "nix/net.nix",
        "nix/network.nix",
        "nix/resources-network.nix",
        "nix/tests/default.nix",
        # The operation-row declaration the broker-operation generator and
        # its drift target read (U2/KTD3).
        "operations.json",
    ],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_network_local",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
        # The include_str! fixtures this crate's test-support code loads.
        "//tests/fixtures:deny-unknown/host-valid.json",
        "//:tests/golden/manifest_v04/baseline-vms.json",
    ],
    deps = [
        "//packages/d2b-provider-guest:d2b_provider_guest",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-provider-process-minijail:d2b_provider_process_minijail",
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_network_local_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
        # The include_str! fixtures this crate's test-support code loads.
        "//tests/fixtures:deny-unknown/host-valid.json",
        "//:tests/golden/manifest_v04/baseline-vms.json",
    ],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_network_local",
    deps = [
        "//packages/d2b-provider-guest:d2b_provider_guest",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-provider-process-minijail:d2b_provider_process_minijail_test_support",
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor_test_support",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "reconcile",
    srcs = ["tests/reconcile.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-provider-guest:d2b_provider_guest",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_network_local",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "ifname_derive",
    srcs = ["tests/ifname_derive.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-provider-guest:d2b_provider_guest",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_network_local",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "net_vm_artifact_is_generic",
    srcs = ["tests/net_vm_artifact_is_generic.rs"],
    compile_data = [
        "Cargo.toml",
        "nix/net-vm.nix",
    ],
    deps = [
        "//packages/d2b-provider-guest:d2b_provider_guest",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_network_local",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "network_primitives",
    srcs = ["tests/network_primitives.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-provider-guest:d2b_provider_guest",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_network_local",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "telemetry_redaction",
    srcs = ["tests/telemetry_redaction.rs"],
    compile_data = ["Cargo.toml"],
    deps = [":d2b_provider_network_local",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session", ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_network_local_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_network_local_test_support",
    deps = [
        "//packages/d2b-provider-guest:d2b_provider_guest",
        "//packages/d2b-provider-process-minijail:d2b_provider_process_minijail_test_support",
        "//packages/d2b-provider-guest-cloud-hypervisor:d2b_provider_guest_cloud_hypervisor_test_support",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "nix/**/*.nix",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_network_local_doc_test",
    crate = "//packages/d2b-provider-network-local:d2b_provider_network_local",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
