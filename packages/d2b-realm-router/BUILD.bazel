load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_realm_router",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-realm-core:d2b_realm_core",
        "//packages/d2b-realm-provider:d2b_realm_provider",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "transport_topology_harness",
    srcs = ["tests/transport_topology_harness.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-realm-core:d2b_realm_core",
        "//packages/d2b-realm-provider:d2b_realm_provider",
        "//packages/d2b-realm-transport:d2b_realm_transport",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_realm_router_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_realm_router",
    deps = [
        "//packages/d2b-realm-codec-protobuf:d2b_realm_codec_protobuf",
        "//packages/d2b-realm-transport:d2b_realm_transport",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
