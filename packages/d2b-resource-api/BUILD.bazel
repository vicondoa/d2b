load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# gazelle:ignore

exports_files(
    [
        "BUILD.bazel",
        "Cargo.toml",
        "tests/external_seals.rs",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "src/admission.rs",
        "src/authz.rs",
        "src/service.rs",
    ],
    visibility = ["//visibility:public"],
)

d2b_resource_api_srcs = [
        "src/adapter.rs",
        "src/admission.rs",
        "src/authz.rs",
        "src/client.rs",
        "src/emergency_gate.rs",
        "src/error.rs",
        "src/generated/d2b_resource_v3_ttrpc.rs",
        "src/generated/mod.rs",
        "src/identity.rs",
        "src/lib.rs",
        "src/metrics.rs",
        "src/quota_gate.rs",
        "src/service.rs",
        "src/store.rs",
        "src/watch.rs",
        "src/zone_service.rs",
]

rust_library(
    name = "d2b_resource_api",
    srcs = d2b_resource_api_srcs,
    compile_data = [
        "Cargo.toml",
        "src/watch.rs",
    ],
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-resource-store:d2b_resource_store",
        "//packages/d2b-resource-store-redb:d2b_resource_store_redb",
        "//packages/d2b-telemetry:d2b_telemetry",
        "@crates//:protobuf",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:ttrpc",
    ],
)

rust_library(
    name = "d2b_resource_api_test_support",
    srcs = d2b_resource_api_srcs,
    compile_data = [
        "Cargo.toml",
        "src/watch.rs",
    ],
    crate_name = "d2b_resource_api",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-core-controller:d2b_core_controller_test_support",
        "//packages/d2b-resource-store:d2b_resource_store_test_support",
        "//packages/d2b-resource-store-redb:d2b_resource_store_redb_test_support",
        "//packages/d2b-telemetry:d2b_telemetry_test_support",
        "@crates//:protobuf",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:ttrpc",
    ],
)

rust_test(
    name = "external_seals",
    srcs = ["tests/external_seals.rs"],
    compile_data = ["Cargo.toml"],
    data = [
        "//bazel/checks/rust:cargo_workspace_sources",
        "//packages/d2b-resource-api/tests/ui/external-seals:Cargo.lock",
        "//packages/d2b-resource-api/tests/ui/external-seals:Cargo.toml",
        "//packages/d2b-resource-api/tests/ui/external-seals:cargo_ui_fixtures",
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
    ],
    env = {
        "D2B_EXTERNAL_SEALS_FIXTURE_MANIFEST": "$(rootpath //packages/d2b-resource-api/tests/ui/external-seals:Cargo.toml)",
        "CARGO": "$(CARGO)",
        "RUSTC": "$(RUSTC)",
    },
    visibility = ["//visibility:public"],
)

rust_test(
    name = "d2b_resource_api_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_api",
    deps = [
        "//packages/d2b-resource-store:d2b_resource_store",
        "@crates//:protobuf",
        "@crates//:tokio",
    ],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
