        "src/adapter.rs",
        "src/admission.rs",
        "src/authz.rs",
        "src/client.rs",
        "src/emergency_gate.rs",
        "src/error.rs",
        "src/generated/d2b_resource_v3_ttrpc.rs",
        "src/generated/mod.rs",
        "src/identity.rs",
        "src/lib.rs",
        "src/metrics.rs",
        "src/quota_gate.rs",
        "src/service.rs",
        "src/store.rs",
        "src/watch.rs",
