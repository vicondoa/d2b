load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)


exports_files(
    [
        "BUILD.bazel",
        "Cargo.toml",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "resource_ttrpc_generated",
    srcs = [
        "src/generated/d2b_resource_v3_ttrpc.rs",
        "src/generated/mod.rs",
    ],
    visibility = ["//visibility:public"],
)

d2b_resource_api_srcs = glob(["src/**/*.rs"], allow_empty = True)

d2b_rust_library(
    name = "d2b_resource_api",
    srcs = d2b_resource_api_srcs,
    compile_data = [
        "Cargo.toml",
        "src/watch.rs",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-provider-role:d2b_provider_role",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-provider-quota:d2b_provider_quota",] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_resource_api_test_support",
    srcs = d2b_resource_api_srcs,
    compile_data = [
        "Cargo.toml",
        "src/watch.rs",
    ],
    crate_name = "d2b_resource_api",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core-controller:d2b_core_controller_test_support",
        "//packages/d2b-provider-role:d2b_provider_role_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-provider-quota:d2b_provider_quota_test_support",] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_resource_api_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_api",
    args = ["--test-threads=1"],
    deps = [
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-provider-quota:d2b_provider_quota",] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_resource_api_doc_test",
    crate = "//packages/d2b-resource-api:d2b_resource_api",
)

test_suite(
    name = "unit",
    tests = [":d2b_resource_api_test"],
)

test_suite(
    name = "doctest",
    tests = [":d2b_resource_api_doc_test"],
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
