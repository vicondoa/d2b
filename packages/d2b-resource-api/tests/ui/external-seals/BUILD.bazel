# keep

load("@rules_rust//rust:defs.bzl", "rust_test")

exports_files(
    ["BUILD.bazel", "Cargo.lock", "Cargo.toml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cargo_ui_fixtures",
    srcs = glob([
        "Cargo.lock",
        "Cargo.toml",
        "tests/**/*.rs",
    ], allow_empty = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "clone_seal_acceptor",
    srcs = ["//packages/d2b-resource-api:tests/external_seals.rs"],
    compile_data = ["//packages/d2b-resource-api:Cargo.toml"],
    data = [
        "//bazel/checks/rust:cargo_workspace_sources",
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
        "@rules_rust//rust/toolchain:current_rust_stdlib_files",
        ":Cargo.toml",
        ":cargo_ui_fixtures",
    ],
    env = {
        "CARGO": "$(rootpath @rules_rust//rust/toolchain:current_cargo_files)",
        "D2B_EXTERNAL_SEALS_CASE": "clone_seal_acceptor",
        "D2B_EXTERNAL_SEALS_FIXTURE_MANIFEST": "$(rootpath :Cargo.toml)",
        "RUSTC": "$(rootpath @rules_rust//rust/toolchain:current_rustc_files)",
        "RUSTUP_TOOLCHAIN": "1.97.0",
    },
    env_inherit = ["HOME", "PATH"],
    tags = ["exclusive", "no-remote-cache", "no-sandbox"],
    visibility = ["//visibility:public"],
)

