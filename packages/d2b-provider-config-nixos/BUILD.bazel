load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//visibility:public"])

d2b_rust_library(
    name = "d2b_provider_config_nixos",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

d2b_rust_test(
    name = "service_contract",
    srcs = ["tests/service_contract.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_config_nixos",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "config_lifecycle",
    srcs = ["tests/config_lifecycle.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_config_nixos",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "redaction",
    srcs = ["tests/redaction.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_config_nixos",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_doc_test(
    name = "d2b_provider_config_nixos_doc_test",
    crate = ":d2b_provider_config_nixos",
)

d2b_rust_test(
    name = "d2b_provider_config_nixos_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_config_nixos",
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all-tests",
    tests = [
        ":service_contract",
        ":config_lifecycle",
        ":redaction",
        ":d2b_provider_config_nixos_test",
        ":d2b_provider_config_nixos_clippy",
        ":service_contract_clippy",
        ":config_lifecycle_clippy",
        ":redaction_clippy",
        ":d2b_provider_config_nixos_test_clippy",
    ],
)
