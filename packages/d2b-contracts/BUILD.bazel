load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")


exports_files(
    ["BUILD.bazel", "Cargo.toml"],
    visibility = ["//visibility:public"],
)

d2b_contracts_srcs = glob(["src/**/*.rs"], allow_empty = True)

filegroup(
    name = "daemon_api_sources",
    srcs = glob(["src/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_contracts",
    srcs = d2b_contracts_srcs,
    compile_data = [
        "Cargo.toml",
        "tests/fixtures/workload-execution-posture-v1.json",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True, cargo_only = True),
)

alias(
    name = "d2b_contracts_test_support",
    actual = ":d2b_contracts",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "foundation",
    srcs = ["tests/foundation.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_contracts_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_contracts",
    deps = [
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_contracts_doc_test",
    crate = "//packages/d2b-contracts:d2b_contracts",
)
