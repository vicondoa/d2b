load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

exports_files(
    ["proto/v3/credential.proto"],
    visibility = ["//visibility:public"],
)

d2b_contracts_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_contracts",
    srcs = d2b_contracts_srcs,
    compile_data = [
        "Cargo.toml",
        "tests/fixtures/workload-execution-posture-v1.json",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True, cargo_only = True),
)

alias(
    name = "d2b_contracts_test_support",
    actual = ":d2b_contracts",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "foundation",
    srcs = ["tests/foundation.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

