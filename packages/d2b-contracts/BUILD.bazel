load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

exports_files(
    ["proto/v3/credential.proto"],
    visibility = ["//visibility:public"],
)

d2b_contracts_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_contracts",
    srcs = d2b_contracts_srcs,
    compile_data = ["Cargo.toml"],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-realm-core:d2b_realm_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_contracts_test_support",
    srcs = d2b_contracts_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_contracts",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-realm-core:d2b_realm_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

