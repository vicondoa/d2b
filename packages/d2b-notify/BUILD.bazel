load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_notify",
    srcs = [
        "src/events.rs",
        "src/lib.rs",
        "src/nonce.rs",
        "src/notifications.rs",
        "src/state.rs",
        "src/waybar.rs",
        "src/wlcontrol.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:getrandom-0.2.17",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "d2b-sk-waybar-helper",
    srcs = ["src/bin/waybar_helper.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":d2b_notify"],
)

rust_test(
    name = "d2b_notify_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_notify",
    deps = ["@crates//:serde_json"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
