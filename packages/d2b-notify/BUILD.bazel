load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "d2b_notify",
    srcs = [
        "src/events.rs",
        "src/lib.rs",
        "src/nonce.rs",
        "src/notifications.rs",
        "src/state.rs",
        "src/waybar.rs",
        "src/wlcontrol.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:getrandom-0.2.17",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "d2b-sk-waybar-helper",
    srcs = ["src/bin/waybar_helper.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":d2b_notify"],
)

rust_test(
    name = "d2b_notify_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_notify",
    deps = ["@crates//:serde_json"],
)
