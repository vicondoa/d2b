load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_notify",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "d2b-sk-waybar-helper",
    srcs = ["src/bin/waybar_helper.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":d2b_notify"] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_notify_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_notify",
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_notify_doc_test",
    crate = "//packages/d2b-notify:d2b_notify",
)
