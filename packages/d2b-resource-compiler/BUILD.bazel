load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "d2b_resource_compiler",
    srcs = [
        "src/lib.rs",
        "src/linux.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-core:d2b_core",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:rustix",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_binary(
    name = "d2b-resource-compiler",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_resource_compiler",
        "//packages/d2b-contracts:d2b_contracts",
        "@crates//:regex",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "cli",
    srcs = ["tests/cli.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "phase2",
    srcs = ["tests/phase2.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_resource_compiler",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-core:d2b_core",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "d2b_resource_compiler_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_compiler",
    deps = ["@crates//:tempfile"],
)

rust_test(
    name = "d2b-resource-compiler_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b-resource-compiler",
