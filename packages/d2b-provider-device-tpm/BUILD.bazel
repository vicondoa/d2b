load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_provider_device_tpm_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_provider_device_tpm",
    srcs = d2b_provider_device_tpm_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",

    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_provider_device_tpm_test_support",
    srcs = d2b_provider_device_tpm_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_device_tpm",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts_test_support",

    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_device_tpm",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "controller_state_machine",
    srcs = ["tests/controller_state_machine.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":d2b_provider_device_tpm_test_support"] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "fault_swtpm_missing",
    srcs = ["tests/fault_swtpm_missing.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [":d2b_provider_device_tpm_test_support"] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)


rust_test(
    name = "resource_controller",
    srcs = [
        "tests/resource_controller.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_device_tpm",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
