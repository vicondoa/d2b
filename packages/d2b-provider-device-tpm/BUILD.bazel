load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-device:__pkg__", "//packages/d2b-provider-endpoint:__pkg__", "//packages/d2bd:__pkg__"])


exports_files(
    ["BUILD.bazel", "nix/default.nix", "nix/guest.nix", "nix/tests/default.nix"],
    visibility = ["//visibility:public"],
)

d2b_provider_device_tpm_srcs = glob(["src/**/*.rs"], allow_empty = True)

d2b_rust_library(
    name = "d2b_provider_device_tpm",
    srcs = d2b_provider_device_tpm_srcs,
    compile_data = [
        "Cargo.toml",
        "//:tests/golden/runner-shape/swtpm-argv-minimal.txt",
    ],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",

    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_device_tpm_test_support",
    srcs = d2b_provider_device_tpm_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_device_tpm",
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",

    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_device_tpm_test",
    crate = ":d2b_provider_device_tpm",
    compile_data = [
        "Cargo.toml",
        "//:tests/golden/runner-shape/swtpm-argv-minimal.txt",
    ],
    deps = all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_device_tpm",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "resource_controller",
    srcs = [
        "tests/resource_controller.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_device_tpm",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_device_tpm_doc_test",
    crate = "//packages/d2b-provider-device-tpm:d2b_provider_device_tpm",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
