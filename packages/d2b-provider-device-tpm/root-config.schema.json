{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["controllerExecutionRef"],
  "properties": {
    "controllerExecutionRef": {
      "type": "string",
      "pattern": "^Host/[a-z][a-z0-9-]{0,62}$"
    },
    "logLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20
    }
  }
}
