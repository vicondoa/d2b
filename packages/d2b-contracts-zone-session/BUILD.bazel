load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//visibility:public"])

zone_session_srcs = glob(["src/**/*.rs"], allow_empty = True)

d2b_rust_library(
    name = "d2b_contracts_zone_session",
    srcs = zone_session_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "contracts",
    srcs = ["tests/contracts.rs"],
    compile_data = ["Cargo.toml"],
    deps = [":d2b_contracts_zone_session", "//packages/d2b-contracts-resource:d2b_contracts_resource", "//packages/d2b-contracts-provider:d2b_contracts_provider"] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

d2b_rust_test(
    name = "d2b_contracts_zone_session_test",
    crate = ":d2b_contracts_zone_session",
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(name = "d2b_contracts_zone_session_doc_test", crate = ":d2b_contracts_zone_session")

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
