load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_relay",
    srcs = ["src/lib.rs"],
    compile_data = ["Cargo.toml"],
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-realm-core:d2b_realm_core",
        "//packages/d2b-realm-provider:d2b_realm_provider",
        "@crates//:base64",
        "@crates//:futures-util",
        "@crates//:hmac",
        "@crates//:libc",
        "@crates//:rustls",
        "@crates//:rustls-pki-types",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:tokio-tungstenite",
        "@crates//:tracing",
        "@crates//:urlencoding",
        "@crates//:webpki-roots",
    ],
)

rust_binary(
    name = "d2b-relay",
    srcs = ["src/bin/d2b-relay.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_relay",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "relay_connect",
    srcs = ["examples/relay_connect.rs"],
    compile_data = ["Cargo.toml"],
    tags = ["example"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_relay",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "relay_listener",
    srcs = ["examples/relay_listener.rs"],
    compile_data = ["Cargo.toml"],
    tags = ["example"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_relay",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "d2b_provider_relay_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_relay",
    deps = ["@crates//:tempfile"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
