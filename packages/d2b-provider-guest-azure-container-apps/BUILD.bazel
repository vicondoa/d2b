load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-guest:__pkg__", "//packages/d2bd:__pkg__"])

exports_files(
    ["BUILD.bazel", "nix/default.nix", "nix/tests/default.nix"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_guest_azure_container_apps",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)

d2b_rust_library(
    name = "d2b_provider_guest_azure_container_apps_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_guest_azure_container_apps",
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)

d2b_rust_test(
    name = "d2b_provider_guest_azure_container_apps_test",
    crate = ":d2b_provider_guest_azure_container_apps",
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "provider_lifecycle",
    srcs = [
        "tests/provider_lifecycle.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        ":d2b_provider_guest_azure_container_apps",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_guest_azure_container_apps_doc_test",
    crate = "//packages/d2b-provider-guest-azure-container-apps:d2b_provider_guest_azure_container_apps",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
