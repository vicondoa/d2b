load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# gazelle:ignore

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
        "src/ownership.rs",
    ],
    visibility = ["//visibility:public"],
)

d2b_resource_store_redb_srcs = [
        "src/actor.rs",
        "src/audit.rs",
        "src/backup.rs",
        "src/keys.rs",
        "src/lib.rs",
        "src/metrics.rs",
        "src/migration.rs",
        "src/ownership.rs",
        "src/revision_log.rs",
        "src/schema.rs",
        "src/tests.rs",
        "src/tracing.rs",
        "src/transaction.rs",
        "src/values.rs",
]

rust_library(
    name = "d2b_resource_store_redb",
    srcs = d2b_resource_store_redb_srcs,
    compile_data = [
        "Cargo.toml",
        "src/actor.rs",
        "src/lib.rs",
        "src/transaction.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-audit:d2b_audit",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-controller-toolkit:d2b_controller_toolkit",
        "//packages/d2b-resource-store:d2b_resource_store",
        "//packages/d2b-telemetry:d2b_telemetry",
        "@crates//:redb",
        "@crates//:rustix",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

rust_library(
    name = "d2b_resource_store_redb_test_support",
    srcs = d2b_resource_store_redb_srcs,
    compile_data = [
        "Cargo.toml",
        "src/actor.rs",
        "src/lib.rs",
        "src/transaction.rs",
    ],
    crate_name = "d2b_resource_store_redb",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-audit:d2b_audit_test_support",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-controller-toolkit:d2b_controller_toolkit_test_support",
        "//packages/d2b-resource-store:d2b_resource_store_test_support",
        "//packages/d2b-telemetry:d2b_telemetry_test_support",
        "@crates//:redb",
        "@crates//:rustix",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "d2b_resource_store_redb_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_resource_store_redb",
    deps = [
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
