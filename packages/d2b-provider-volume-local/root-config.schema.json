{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "controllerExecutionRef": {
      "type": "string",
      "pattern": "^Host/[a-z][a-z0-9-]{0,62}$"
    },
    "sourcePolicies": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "volumeKinds"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "class": {
            "enum": ["local-path", "block-image", "tmpfs"]
          },
          "volumeKinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": ["durable", "ephemeral", "state", "tmp", "cache"]
            }
          }
        }
      }
    }
  }
}
