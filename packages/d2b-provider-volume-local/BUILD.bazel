# The production controller + anchored adapter composition tests moved with
# the adapter from `packages/d2bd/tests/volume_effect_adapter.rs` (U7): the
# anchored-fd implementation now lives in the crate that owns the ports it
# implements, and the tests that pin its marker, lock, and store-view
# invariants live beside it.
d2b_rust_test(
    name = "volume_effect_adapter",
    srcs = ["tests/volume_effect_adapter.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-host:d2b_host_test_support",
        "//packages/d2b-provider-network-local:d2b_provider_network_local_test_support",
        ":d2b_provider_volume_local_test_support",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_volume_local_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_volume_local_test_support",
    deps = [
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_volume_local_doc_test",
    crate = "//packages/d2b-provider-volume-local:d2b_provider_volume_local",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
