load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-volume:__pkg__", "//packages/d2bd:__pkg__"])


exports_files(
    [
        "BUILD.bazel",
        "nix/options-volumes.nix",
        "nix/resources-volume.nix",
        "nix/resources-zones-volumes.nix",
        "nix/store.nix",
        "nix/storage-json.nix",
        "nix/sync-json.nix",
        "nix/default.nix",
        "nix/tests/default.nix",
        "nix/zone-storage-json.nix",
    ],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_volume_local",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-host:d2b_host",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_volume_local_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_volume_local",
    deps = [
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-host:d2b_host_test_support",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

