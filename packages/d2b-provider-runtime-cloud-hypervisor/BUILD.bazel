load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_runtime_cloud_hypervisor",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-host-argv:d2b_host_argv",
        "//packages/d2b-process-conformance:d2b_process_conformance",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "scaffold",
    srcs = ["tests/scaffold.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)


rust_test(
    name = "adoption",
    srcs = [
        "tests/adoption.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_runtime_cloud_hypervisor",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "reconcile_state",
    srcs = [
        "tests/reconcile_state.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        ":d2b_provider_runtime_cloud_hypervisor",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "state_status_test",
    srcs = [
        "tests/state_status_test.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_runtime_cloud_hypervisor",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "vmm_argv_golden_test",
    srcs = [
        "tests/vmm_argv_golden_test.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_runtime_cloud_hypervisor",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_runtime_cloud_hypervisor_doc_test",
    crate = "//packages/d2b-provider-runtime-cloud-hypervisor:d2b_provider_runtime_cloud_hypervisor",
)
