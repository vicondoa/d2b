load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//visibility:public"])
exports_files(["proto/credential.proto"], visibility = ["//visibility:public"])

provider_srcs = glob(["src/**/*.rs"], allow_empty = True)

# The generated telemetry label catalog the crate validates against;
# `gen-layer-catalogs` writes it and
# `//packages/xtask:gen_layer_catalogs_drift` compares it byte-for-byte.
filegroup(
    name = "generated_telemetry_catalog",
    srcs = glob(["src/v3/generated/*.rs"]),
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_contracts_provider",
    srcs = provider_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "schema",
    srcs = ["tests/schema.rs"],
    compile_data = ["Cargo.toml"],
    deps = [":d2b_contracts_provider", "//packages/d2b-contracts-resource:d2b_contracts_resource"] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

d2b_rust_test(
    name = "d2b_contracts_provider_test",
    crate = ":d2b_contracts_provider",
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "proto/**/*.proto",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(name = "d2b_contracts_provider_doc_test", crate = ":d2b_contracts_provider")

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
