load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["BUILD.bazel"], visibility = ["//visibility:public"])

# keep

d2b_core_controller_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_core_controller",
    srcs = d2b_core_controller_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-audit:d2b_audit",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-controller-toolkit:d2b_controller_toolkit",
        "//packages/d2b-telemetry:d2b_telemetry",
        "//packages/d2b-provider-system-core:d2b_provider_system_core",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_core_controller_test_support",
    srcs = d2b_core_controller_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_core_controller",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-audit:d2b_audit_test_support",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-controller-toolkit:d2b_controller_toolkit_test_support",
        "//packages/d2b-provider-system-core:d2b_provider_system_core_test_support",
        "//packages/d2b-telemetry:d2b_telemetry_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

