load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

exports_files(["BUILD.bazel"], visibility = ["//visibility:public"])

# keep

d2b_core_controller_srcs = glob(["src/**/*.rs"], allow_empty = True)

d2b_rust_library(
    name = "d2b_core_controller",
    srcs = d2b_core_controller_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-controller-toolkit:d2b_controller_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_core_controller_test_support",
    srcs = d2b_core_controller_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_core_controller",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-controller-toolkit:d2b_controller_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "owned_children",
    srcs = ["tests/owned_children.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_core_controller",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_core_controller_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_core_controller",
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob([
        "Cargo.lock",
        "Cargo.toml",
        "benches/**/*.rs",
        "build.rs",
        "examples/**/*.rs",
        "src/**/*.rs",
        "tests/**/*.rs",
    ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_core_controller_doc_test",
    crate = "//packages/d2b-core-controller:d2b_core_controller",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
