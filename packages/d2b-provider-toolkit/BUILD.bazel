load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# gazelle:ignore

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

exports_files(
    ["src/conformance.rs"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_toolkit",
    srcs = [
        "src/agent.rs",
        "src/audit.rs",
        "src/bootstrap.rs",
        "src/conformance.rs",
        "src/dispatch.rs",
        "src/error.rs",
        "src/fakes.rs",
        "src/fixture.rs",
        "src/lib.rs",
        "src/manifest.rs",
        "src/redaction.rs",
        "src/registration.rs",
        "src/schema.rs",
        "src/server.rs",
        "src/testing.rs",
        "src/values.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider:d2b_provider",
        "//packages/d2b-session:d2b_session",
        "@crates//:schemars",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "d2b-provider-toolkit",
    srcs = ["src/bin/d2b-provider-toolkit.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider:d2b_provider",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "fake_provider",
    srcs = ["tests/fake_provider.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
    ],
)

rust_test(
    name = "malicious_provider",
    srcs = ["tests/malicious_provider.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
    ],
)

rust_test(
    name = "d2b_provider_toolkit_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_toolkit",
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    deps = ["//packages/d2b-provider:d2b_provider"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
