load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

exports_files(
    ["src/conformance.rs"],
    visibility = ["//visibility:public"],
)

d2b_provider_toolkit_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_provider_toolkit",
    srcs = d2b_provider_toolkit_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["unix-transport"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider:d2b_provider",
        "//packages/d2b-session:d2b_session",
        "//packages/d2b-session-unix:d2b_session_unix_host_socket",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_provider_toolkit_test_support",
    srcs = d2b_provider_toolkit_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["unix-transport"],
    crate_name = "d2b_provider_toolkit",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider:d2b_provider",
        "//packages/d2b-session:d2b_session_test_support",
        "//packages/d2b-session-unix:d2b_session_unix_host_socket_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "d2b-provider-toolkit",
    srcs = ["src/bin/d2b-provider-toolkit.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-provider:d2b_provider",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "fake_provider",
    srcs = ["tests/fake_provider.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "malicious_provider",
    srcs = ["tests/malicious_provider.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_toolkit",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_provider_toolkit_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_toolkit_test_support",
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    deps = ["//packages/d2b-provider:d2b_provider"] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
