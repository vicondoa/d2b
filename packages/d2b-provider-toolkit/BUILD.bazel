load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-clipboard-wayland:__pkg__", "//packages/d2b-provider-credential-entra:__pkg__", "//packages/d2b-provider-credential-managed-identity:__pkg__", "//packages/d2b-provider-credential-secret-service:__pkg__", "//packages/d2b-provider-device:__pkg__", "//packages/d2b-provider-device-security-key:__pkg__", "//packages/d2b-provider-device-usbip:__pkg__", "//packages/d2b-provider-display-wayland:__pkg__", "//packages/d2b-provider-guest-azure-virtual-machine:__pkg__", "//packages/d2b-provider-network-local:__pkg__", "//packages/d2b-provider-notification-desktop:__pkg__", "//packages/d2b-provider-observability-otel:__pkg__", "//packages/d2b-provider-process-systemd:__pkg__", "//packages/d2b-sk-frontend:__pkg__", "//packages/d2b-zone-routing:__pkg__", "//packages/d2bd:__pkg__"])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_provider_toolkit_srcs = glob(["src/**/*.rs"], allow_empty = True)

d2b_rust_library(
    name = "d2b_provider_toolkit",
    srcs = d2b_provider_toolkit_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["unix-transport"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-provider:d2b_provider",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-session:d2b_session",
        "//packages/d2b-session-unix:d2b_session_unix",
        "@crates//:serde",
        "@crates//:zeroize",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_toolkit_test_support",
    srcs = d2b_provider_toolkit_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["unix-transport"],
    crate_name = "d2b_provider_toolkit",
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-provider:d2b_provider_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-session:d2b_session_test_support",
        "//packages/d2b-session-unix:d2b_session_unix_test_support",
        "@crates//:serde",
        "@crates//:zeroize",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_binary(
    name = "d2b-provider-toolkit",
    srcs = ["src/bin/d2b-provider-toolkit.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_toolkit",
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-provider:d2b_provider",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "fake_provider",
    srcs = ["tests/fake_provider.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_toolkit",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "malicious_provider",
    srcs = ["tests/malicious_provider.rs"],
    compile_data = ["Cargo.toml"],
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_toolkit",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "supervised_runtime",
    srcs = ["tests/supervised_runtime.rs"],
    compile_data = ["Cargo.toml"],
    args = ["--test-threads=1"],
    data = [
        "//packages/d2b-provider-credential-secret-service:d2b-provider-credential-secret-service",
        "//packages/d2b-provider-credential-entra:d2b-provider-credential-entra",
        "//packages/d2b-provider-credential-managed-identity:d2b-managed-identity-controller",
        "//packages/d2b-provider-credential-managed-identity:d2b-managed-identity-agent",
    ],
    env = {
        "CARGO_BIN_EXE_d2b-provider-credential-secret-service": "$(rootpath //packages/d2b-provider-credential-secret-service:d2b-provider-credential-secret-service)",
        "CARGO_BIN_EXE_d2b-provider-credential-entra": "$(rootpath //packages/d2b-provider-credential-entra:d2b-provider-credential-entra)",
        "CARGO_BIN_EXE_d2b-managed-identity-controller": "$(rootpath //packages/d2b-provider-credential-managed-identity:d2b-managed-identity-controller)",
        "CARGO_BIN_EXE_d2b-managed-identity-agent": "$(rootpath //packages/d2b-provider-credential-managed-identity:d2b-managed-identity-agent)",
    },
    rustc_env = {
        "CARGO_BIN_EXE_d2b-provider-credential-secret-service": "$(rootpath //packages/d2b-provider-credential-secret-service:d2b-provider-credential-secret-service)",
        "CARGO_BIN_EXE_d2b-provider-credential-entra": "$(rootpath //packages/d2b-provider-credential-entra:d2b-provider-credential-entra)",
        "CARGO_BIN_EXE_d2b-managed-identity-controller": "$(rootpath //packages/d2b-provider-credential-managed-identity:d2b-managed-identity-controller)",
        "CARGO_BIN_EXE_d2b-managed-identity-agent": "$(rootpath //packages/d2b-provider-credential-managed-identity:d2b-managed-identity-agent)",
    },
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_toolkit_test_support",
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-session:d2b_session_test_support",
        "//packages/d2b-session-unix:d2b_session_unix_test_support",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "harness",
    srcs = ["tests/harness.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-resource-types:d2b_resource_types",
        "//packages/d2b-session:d2b_session",
        "//packages/d2b-session-unix:d2b_session_unix",
        ":d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_toolkit_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_toolkit_test_support",
    data = [":d2b-provider-toolkit"],
    env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-provider-toolkit": "$(rootpath :d2b-provider-toolkit)"},
    deps = all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_toolkit_doc_test",
    crate = "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
