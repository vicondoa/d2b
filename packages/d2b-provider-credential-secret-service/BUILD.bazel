load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-credential:__pkg__", "//packages/d2b-provider-toolkit:__pkg__", "//packages/d2bd:__pkg__"])

exports_files(["BUILD.bazel"], visibility = ["//visibility:public"])

# keep

d2b_rust_library(
    name = "d2b_provider_credential_secret_service",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_credential_secret_service_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_credential_secret_service",
    deps = [
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_binary(
    name = "d2b-provider-credential-secret-service",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    deps = [":d2b_provider_credential_secret_service"] + all_crate_deps(normal = True, cargo_only = True),
)

