load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_shell_terminal",
    srcs = [
        "src/authz.rs",
        "src/guest_rules.rs",
        "src/host_rules.rs",
        "src/lib.rs",
        "src/migration.rs",
        "src/observability.rs",
        "src/process_lifecycle.rs",
        "src/process_templates.rs",
        "src/resources/mod.rs",
        "src/resources/pool.rs",
        "src/resources/session.rs",
        "src/service/controller.rs",
        "src/service/mod.rs",
        "src/service/supervisor.rs",
        "src/session/adopt.rs",
        "src/session/mod.rs",
        "src/session/ring.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-process-conformance:d2b_process_conformance",
    ],
    visibility = ["//visibility:public"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
