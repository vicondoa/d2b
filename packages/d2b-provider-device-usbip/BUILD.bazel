load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-device:__pkg__", "//packages/d2bd:__pkg__"])


exports_files(
    ["BUILD.bazel", "nix/default.nix", "nix/guest.nix", "nix/tests/default.nix"],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_device_usbip",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
    ],
    deps = [
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        "@crates//:libc",
        "@crates//:serde",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_device_usbip_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
    ],
    crate_name = "d2b_provider_device_usbip",
    crate_features = ["test-support"],
    deps = [
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-core-controller:d2b_core_controller_test_support",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:serde_json",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_device_usbip_test",
    crate = ":d2b_provider_device_usbip",
    compile_data = [
        "Cargo.toml",
        "//tests/fixtures:deny-unknown/host-valid.json",
        "//:tests/golden/manifest_v04/baseline-vms.json",
    ],
    deps = [
        "//packages/d2b-core-controller:d2b_core_controller",
        "//packages/d2b-contracts-provider:d2b_contracts_provider",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
        "@crates//:serde_json",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

