load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_device_usbip",
    srcs = [
        "src/arbitration.rs",
        "src/busid.rs",
        "src/controller.rs",
        "src/firewall.rs",
        "src/lib.rs",
        "src/process.rs",
        "src/workers.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = ["//packages/d2b-contracts:d2b_contracts"],
)

