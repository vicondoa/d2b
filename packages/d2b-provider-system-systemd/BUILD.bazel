load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_system_systemd",
    srcs = [
        "src/adoption.rs",
        "src/effect_port.rs",
        "src/guest_exec.rs",
        "src/launch.rs",
        "src/lib.rs",
        "src/sandbox.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-process-conformance:d2b_process_conformance",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
    ],
)

rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_system_systemd",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-process-conformance:d2b_process_conformance",
    ],
)

rust_test(
    name = "execution_parents",
    srcs = ["tests/execution_parents.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_system_systemd",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-process-conformance:d2b_process_conformance",
    ],
)

rust_test(
    name = "d2b_provider_system_systemd_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_system_systemd",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
