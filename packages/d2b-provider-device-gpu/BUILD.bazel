load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-device:__pkg__", "//packages/d2bd:__pkg__"])


exports_files(
    [
        "BUILD.bazel",
        "nix/default.nix",
        "nix/guest.nix",
        "nix/video-guest.nix",
        "nix/tests/default.nix",
    ],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_device_gpu",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
        "//:tests/golden/runner-shape/gpu-argv-minimal.txt",
        "//:tests/golden/runner-shape/video-argv-minimal.txt",
    ],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_device_gpu_test",
    crate = ":d2b_provider_device_gpu",
    compile_data = [
        "Cargo.toml",
        "//:tests/golden/runner-shape/gpu-argv-minimal.txt",
        "//:tests/golden/runner-shape/video-argv-minimal.txt",
    ],
    deps = all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "combined_reconcile",
    srcs = ["tests/combined_reconcile.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_device_gpu",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_device_gpu",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "render_node_enforcement",
    srcs = ["tests/render_node_enforcement.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_device_gpu",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "authority_lifecycle",
    srcs = [
        "tests/authority_lifecycle.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_device_gpu",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "worker_contract",
    srcs = [
        "tests/worker_contract.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_device_gpu",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_device_gpu_doc_test",
    crate = "//packages/d2b-provider-device-gpu:d2b_provider_device_gpu",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
