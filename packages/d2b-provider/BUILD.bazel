load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_provider_srcs = [
        "src/agent.rs",
        "src/context.rs",
        "src/descriptor.rs",
        "src/error.rs",
        "src/forwarding.rs",
        "src/identity.rs",
        "src/installation.rs",
        "src/instance.rs",
        "src/lib.rs",
        "src/registry.rs",
        "src/rpc.rs",
        "src/session.rs",
        "src/share_adapter.rs",
]

rust_library(
    name = "d2b_provider",
    srcs = d2b_provider_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-zone-routing:d2b_zone_routing",
        "@crates//:tokio",
    ],
)

rust_library(
    name = "d2b_provider_test_support",
    srcs = d2b_provider_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-zone-routing:d2b_zone_routing_test_support",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "runtime",
    srcs = ["tests/runtime.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider",
        "//packages/d2b-contracts:d2b_contracts",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "d2b_provider_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
