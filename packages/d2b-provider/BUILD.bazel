load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_provider_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_provider",
    srcs = d2b_provider_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-zone-routing:d2b_zone_routing",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_provider_test_support",
    srcs = d2b_provider_srcs,
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-zone-routing:d2b_zone_routing_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "runtime",
    srcs = ["tests/runtime.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_provider_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
