load("@crates//:defs.bzl", "all_crate_deps")
load(
    "//bazel/checks/rust:d2b_rust_rules.bzl",
    "d2b_rust_binary",
    "d2b_rust_library",
    "d2b_rust_test",
    "d2b_rust_doc_test",
)

# Provider crates link only from the daemon composition root and the
# enumerated consumers; broker/shared crates cannot depend on them (U14).
package(default_visibility = ["//bazel/checks:__pkg__", "//packages/d2b-provider-device-security-key:__pkg__", "//packages/d2b-provider-process:__pkg__", "//packages/d2b-provider-supervisor:__pkg__", "//packages/d2bd:__pkg__"])


exports_files(
    [
        "BUILD.bazel",
        # The operation-row declaration the broker-operation generator and
        # its drift target read (U2/KTD3).
        "operations.json",
    ],
    visibility = ["//visibility:public"],
)

d2b_rust_library(
    name = "d2b_provider_process_systemd",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-control:d2b_contracts_control",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core:d2b_core",
        "//packages/d2b-process-conformance:d2b_process_conformance",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_library(
    name = "d2b_provider_process_systemd_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_process_systemd",
    deps = [
        # Mirrors the library target's dependency list: the test-support
        # target globs the same source tree, so it must link the same
        # crates the library target gained for the family sources.
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-control:d2b_contracts_control",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-core:d2b_core_test_support",
        "//packages/d2b-process-conformance:d2b_process_conformance_test_support",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
        "//packages/d2b-resource-runtime:d2b_resource_runtime",
        "//packages/d2b-resource-types:d2b_resource_types_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

d2b_rust_test(
    name = "conformance",
    srcs = ["tests/conformance.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_provider_process_systemd",
        "//packages/d2b-process-conformance:d2b_process_conformance",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "execution_parents",
    srcs = ["tests/execution_parents.rs"],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_provider_process_systemd",
        "//packages/d2b-process-conformance:d2b_process_conformance",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "d2b_provider_process_systemd_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_process_systemd",
    deps = all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)


d2b_rust_test(
    name = "boundaries",
    srcs = [
        "tests/boundaries.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        ":d2b_provider_process_systemd",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "controller",
    srcs = [
        "tests/controller.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-process-conformance:d2b_process_conformance",
        ":d2b_provider_process_systemd",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

d2b_rust_test(
    name = "lifecycle",
    srcs = [
        "tests/lifecycle.rs",
    ],
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-process-conformance:d2b_process_conformance",
        ":d2b_provider_process_systemd",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

d2b_rust_doc_test(
    name = "d2b_provider_process_systemd_doc_test",
    crate = "//packages/d2b-provider-process-systemd:d2b_provider_process_systemd",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
