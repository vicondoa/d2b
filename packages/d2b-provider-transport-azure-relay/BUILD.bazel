load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_transport_azure_relay",
    srcs = [
        "src/audit.rs",
        "src/backpressure.rs",
        "src/credential_client.rs",
        "src/gateway_compat.rs",
        "src/lib.rs",
        "src/metrics.rs",
        "src/reconnect.rs",
        "src/relay_transport.rs",
        "src/transport_settings.rs",
    ],
    compile_data = [
        "Cargo.toml",
        "//:docs/reference/schemas/v3/providers/transport-azure-relay.transport-settings.json",  # keep
    ],
    deps = [
        "@crates//:base64",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-realm-core:d2b_realm_core",
        "//packages/d2b-realm-provider:d2b_realm_provider",
        "@crates//:hmac",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:urlencoding",
        "@crates//:zeroize",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "scaffold",
    srcs = ["tests/scaffold.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
