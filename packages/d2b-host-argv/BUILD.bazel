load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")


exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_host_argv_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_host_argv",
    srcs = d2b_host_argv_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "d2b_host_argv_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_host_argv",
    deps = [
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
