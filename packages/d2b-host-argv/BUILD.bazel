load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# gazelle:ignore

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_host_argv_srcs = [
    "src/lib.rs",
]

rust_library(
    name = "d2b_host_argv",
    srcs = d2b_host_argv_srcs,
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
    ],
)

rust_test(
    name = "d2b_host_argv_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_host_argv",
    deps = [
        "@crates//:serde_json",
    ],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
