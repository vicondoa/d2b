{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "tests/AGENTS.md"
  ],
  "plugin": [
    "@bybrawe/opencode-loop"
  ],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "ask"
    },
    "external_directory": {
      "*": "allow",
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/run/d2b-heavy-gates/**": "allow",
      "~/.cache/d2b-sccache/**": "allow",
      "~/projects/d2b*/**": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny"
    }
  }
}
