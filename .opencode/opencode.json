{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "tests/AGENTS.md"
  ],
  "plugin": [
    "@bybrawe/opencode-loop"
  ],
  "agent": {
    "general": {
      "model": "github-copilot/gpt-5.6-sol",
      "reasoningEffort": "xhigh"
    },
    "explore": {
      "model": "github-copilot/gpt-5.6-sol",
      "reasoningEffort": "xhigh"
    },
    "panel": {
      "description": "Read-only ADR-046 binding panel reviewer. One lane per roster role, dispatched only at wave close against the wave's immutable snapshot.",
      "mode": "subagent",
      "model": "github-copilot/gemini-3.1-pro-preview",
      "reasoningEffort": "high",
      "tools": {
        "write": false,
        "edit": false,
        "patch": false,
        "bash": false
      }
    }
  },
  "permission": "allow"
}
