      "x-d2b-reference-scope": "same-zone"
    },
    "serviceRef": {
      "pattern": "^usb\\.d2bus\\.org\\.UsbService\\/[a-z][a-z0-9-]{0,62}$",
      "type": "string",
      "x-d2b-allowed-ref-types": [
        "usb.d2bus.org.UsbService"
      ],
      "x-d2b-reference-kind": "ResourceRef",
      "x-d2b-reference-scope": "same-zone"
    },
    "updatePolicy": {}
  },
  "required": [
    "accessPolicy",
    "attachmentPolicy",
    "guestRef",
    "providerRef",
    "serviceRef"
  ],
  "title": "usb.d2bus.org/UsbBinding/spec",
  "type": "object",
