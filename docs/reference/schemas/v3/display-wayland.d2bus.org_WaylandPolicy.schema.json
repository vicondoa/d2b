{
  "$id": "https://d2bus.org/schemas/v3/display-wayland.d2bus.org.WaylandPolicy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provider-owned Wayland policy ResourceType envelope.",
  "properties": {
    "apiVersion": {
      "const": "resources.d2bus.org/v3"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "ownerRef": {
          "pattern": "^(?:Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "zone": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "zone"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "allowGlobals": {
          "items": {
            "maxLength": 63,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "defaults": {
          "additionalProperties": false,
          "properties": {
            "acceleratedRendering": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "appDefaults": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "clipboardBoundary": {
              "enum": [
                "deny",
                "virtualize"
              ]
            },
            "highRisk": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "offDefaults": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "unclassified": {
              "enum": [
                "allow",
                "deny"
              ]
            }
          },
          "required": [
            "acceleratedRendering",
            "clipboardBoundary",
            "highRisk",
            "appDefaults",
            "offDefaults",
            "unclassified"
          ],
          "type": "object"
        },
        "denyGlobals": {
          "items": {
            "maxLength": 63,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "dmabufAllow": {
          "items": {
            "maxLength": 63,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "dmabufDeny": {
          "items": {
            "maxLength": 63,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "maxVersions": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "allowGlobals",
        "denyGlobals",
        "maxVersions",
        "dmabufAllow",
        "dmabufDeny",
        "defaults"
      ],
      "type": "object"
    },
    "type": {
      "const": "display-wayland.d2bus.org.WaylandPolicy"
    }
  },
  "required": [
    "apiVersion",
    "metadata",
    "spec",
    "type"
  ],
  "title": "display-wayland.d2bus.org.WaylandPolicy",
  "type": "object",
  "x-d2b-resource-type": "display-wayland.d2bus.org.WaylandPolicy"
}
