{
  "$id": "https://d2bus.org/schemas/v3/Credential.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "AudienceToken": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "CredentialRevocationPolicy": {
      "additionalProperties": false,
      "description": "Revocation settings.",
      "properties": {
        "onOwnerDelete": {
          "$ref": "#/definitions/RevocationAction"
        },
        "onProviderGeneration": {
          "$ref": "#/definitions/RevocationAction"
        }
      },
      "required": [
        "onOwnerDelete",
        "onProviderGeneration"
      ],
      "type": "object"
    },
    "CredentialRotationPolicy": {
      "description": "Rotation settings.",
      "properties": {
        "maxLeaseLifetimeMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "policy": {
          "$ref": "#/definitions/RotationPolicyClass"
        },
        "proactiveWindowMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "maxLeaseLifetimeMs",
        "policy"
      ],
      "type": "object"
    },
    "CredentialScope": {
      "description": "Placement restriction on lease acquisition.",
      "properties": {
        "domainFilter": {
          "anyOf": [
            {
              "$ref": "#/definitions/ExecutionDomain"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "userRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ExecutionDomain": {
      "description": "The plain execution domain enumeration shared by Host, Guest, and Process.",
      "enum": [
        "system",
        "user"
      ],
      "type": "string"
    },
    "ExpirySpec": {
      "description": "Hard expiry settings.",
      "properties": {
        "hardDeadlineMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "hardDeadlineMs"
      ],
      "type": "object"
    },
    "OperationClass": {
      "description": "The closed typed operation classes a consumer may be granted.",
      "enum": [
        "acquire-token",
        "refresh-token",
        "revoke-token",
        "sign-challenge",
        "inspect-metadata"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "oneOf": [
        {
          "maxLength": 80,
          "minLength": 6,
          "pattern": "^(Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport)/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "maxLength": 201,
          "minLength": 15,
          "pattern": "^[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      ]
    },
    "RevocationAction": {
      "description": "How active leases are treated on a revocation trigger.",
      "enum": [
        "immediate",
        "drain-leases"
      ],
      "type": "string"
    },
    "RotationPolicyClass": {
      "description": "Rotation policy class.",
      "enum": [
        "on-expiry",
        "proactive",
        "on-demand"
      ],
      "type": "string"
    }
  },
  "description": "Opaque rotating credential lease policy.",
  "properties": {
    "apiVersion": {
      "const": "resources.d2bus.org/v3"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value annotation map.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value label map.",
          "type": "object"
        },
        "name": {
          "description": "Zone-local resource name.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "ownerRef": {
          "description": "Optional same-Zone ref of the owning resource.",
          "pattern": "^[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "zone": {
          "description": "Name of the Zone this resource is local to.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "zone"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "description": "The Credential ResourceType base spec.",
      "properties": {
        "allowedOperations": {
          "items": {
            "$ref": "#/definitions/OperationClass"
          },
          "type": "array"
        },
        "audience": {
          "$ref": "#/definitions/AudienceToken"
        },
        "consumerRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiry": {
          "$ref": "#/definitions/ExpirySpec"
        },
        "identityGuestRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "loginEndpointRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "additionalProperties": false,
          "properties": {
            "schemaId": {
              "maxLength": 201,
              "minLength": 1,
              "type": "string"
            },
            "schemaVersion": {
              "maxLength": 32,
              "minLength": 3,
              "type": "string"
            },
            "settings": {
              "type": "object"
            }
          },
          "required": [
            "schemaId",
            "schemaVersion",
            "settings"
          ],
          "type": "object"
        },
        "providerRef": {
          "pattern": "^[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "revocation": {
          "$ref": "#/definitions/CredentialRevocationPolicy"
        },
        "rotation": {
          "$ref": "#/definitions/CredentialRotationPolicy"
        },
        "scope": {
          "$ref": "#/definitions/CredentialScope"
        },
        "updatePolicy": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "automatic",
                "manual-disruptive"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [
        "allowedOperations",
        "audience",
        "expiry",
        "revocation",
        "rotation",
        "scope"
      ],
      "title": "CredentialSpec",
      "type": "object"
    },
    "type": {
      "const": "Credential"
    }
  },
  "required": [
    "apiVersion",
    "metadata",
    "spec",
    "type"
  ],
  "title": "Credential",
  "type": "object"
}
