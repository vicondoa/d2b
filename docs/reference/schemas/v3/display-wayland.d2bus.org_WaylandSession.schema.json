{
  "$id": "https://d2bus.org/schemas/v3/display-wayland.d2bus.org.WaylandSession",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provider-owned Wayland session ResourceType envelope.",
  "properties": {
    "apiVersion": {
      "const": "resources.d2bus.org/v3"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "ownerRef": {
          "pattern": "^(?:Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "zone": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "zone"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "crossDomainTrusted": {
          "const": true,
          "type": "boolean"
        },
        "filter": {
          "additionalProperties": false,
          "properties": {
            "allowGlobals": {
              "items": {
                "maxLength": 63,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "debugLogging": {
              "type": "boolean"
            },
            "denyGlobals": {
              "items": {
                "maxLength": 63,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "dmabufAllow": {
              "items": {
                "maxLength": 63,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "dmabufDeny": {
              "items": {
                "maxLength": 63,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "maxVersions": {
              "additionalProperties": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "object"
            }
          },
          "required": [
            "debugLogging",
            "denyGlobals",
            "allowGlobals",
            "maxVersions",
            "dmabufAllow",
            "dmabufDeny"
          ],
          "type": "object"
        },
        "guestRef": {
          "pattern": "^(?:Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [
            "Guest"
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "hostRef": {
          "pattern": "^(?:Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [
            "Host"
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "activeColor": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            "borderEnabled": {
              "type": "boolean"
            },
            "borderWidth": {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            "inactiveColor": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            "label": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "type": "string"
            },
            "labelEnabled": {
              "type": "boolean"
            },
            "labelPosition": {
              "enum": [
                "top-left",
                "top-center"
              ],
              "type": "string"
            },
            "labelText": {
              "maxLength": 64,
              "type": [
                "string",
                "null"
              ]
            },
            "urgentColor": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            }
          },
          "required": [
            "label",
            "activeColor",
            "inactiveColor",
            "urgentColor",
            "borderEnabled",
            "borderWidth",
            "labelEnabled",
            "labelText",
            "labelPosition"
          ],
          "type": "object"
        },
        "policyRef": {
          "pattern": "^(?:Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [
            "display-wayland.d2bus.org.WaylandPolicy"
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "reconnectGeneration": {
          "minimum": 1,
          "type": "integer"
        },
        "userRef": {
          "pattern": "^(?:Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [
            "User"
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "virglVideo": {
          "type": "boolean"
        }
      },
      "required": [
        "guestRef",
        "hostRef",
        "userRef",
        "policyRef",
        "identity",
        "crossDomainTrusted",
        "virglVideo",
        "filter"
      ],
      "type": "object"
    },
    "type": {
      "const": "display-wayland.d2bus.org.WaylandSession"
    }
  },
  "required": [
    "apiVersion",
    "metadata",
    "spec",
    "type"
  ],
  "title": "display-wayland.d2bus.org.WaylandSession",
  "type": "object",
  "x-d2b-resource-type": "display-wayland.d2bus.org.WaylandSession"
}
