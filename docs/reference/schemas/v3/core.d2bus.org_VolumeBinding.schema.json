{
  "$id": "https://d2bus.org/schemas/v3/core.d2bus.org_VolumeBinding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "AttachmentAccess": {
      "description": "Access level of one Volume attachment.",
      "enum": [
        "read-only",
        "read-write",
        "shared-write"
      ],
      "type": "string"
    },
    "BoundedToken": {
      "maxLength": 63,
      "minLength": 1,
      "type": "string"
    },
    "ResourceRef": {
      "oneOf": [
        {
          "maxLength": 80,
          "minLength": 6,
          "pattern": "^(Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|VolumeBinding|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport)/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "maxLength": 201,
          "minLength": 15,
          "pattern": "^[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      ],
      "x-d2b-reference-kind": "ResourceRef",
      "x-d2b-reference-scope": "same-zone"
    }
  },
  "description": "Durable neutral Volume view attachment to one execution target.",
  "properties": {
    "apiVersion": {
      "const": "resources.d2bus.org/v3"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value annotation map.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value label map.",
          "type": "object"
        },
        "name": {
          "description": "Zone-local resource name.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "ownerRef": {
          "description": "Optional same-Zone ref of the owning resource.",
          "pattern": "^(?:[A-Z][A-Za-z0-9]{0,62}|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "zone": {
          "description": "Name of the Zone this resource is local to.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "zone"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "description": "Strict base VolumeBinding specification.",
      "properties": {
        "access": {
          "$ref": "#/definitions/AttachmentAccess"
        },
        "executionRef": {
          "$ref": "#/definitions/ResourceRef",
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "mountPath": {
          "type": "string"
        },
        "providerRef": {
          "pattern": "^Provider/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [
            "Provider"
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "updatePolicy": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "automatic",
                "manual-disruptive"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "view": {
          "$ref": "#/definitions/BoundedToken"
        },
        "volumeRef": {
          "$ref": "#/definitions/ResourceRef",
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        }
      },
      "required": [
        "access",
        "executionRef",
        "mountPath",
        "view",
        "volumeRef"
      ],
      "title": "VolumeBindingSpec",
      "type": "object"
    },
    "type": {
      "const": "VolumeBinding"
    }
  },
  "required": [
    "apiVersion",
    "metadata",
    "spec",
    "type"
  ],
  "title": "VolumeBinding",
  "type": "object",
  "x-d2b-resource-type": "VolumeBinding"
}
