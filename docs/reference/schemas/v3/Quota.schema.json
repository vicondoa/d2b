{
  "$id": "https://d2bus.org/schemas/v3/Quota.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Zone-wide aggregate resource ceilings.",
  "properties": {
    "apiVersion": {
      "const": "resources.d2bus.org/v3"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value annotation map.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value label map.",
          "type": "object"
        },
        "name": {
          "description": "Zone-local resource name.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "ownerRef": {
          "description": "Optional same-Zone ref of the owning resource.",
          "pattern": "^[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "zone": {
          "description": "Name of the Zone this resource is local to.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "zone"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "ceilings": {
          "additionalProperties": false,
          "properties": {
            "maxCpu": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxMemoryMib": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxOwnerDepth": {
              "maximum": 32,
              "minimum": 1,
              "type": "integer"
            },
            "maxResources": {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            "maxResourcesPerType": {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            "maxStorageGib": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "maxResources",
            "maxResourcesPerType",
            "maxOwnerDepth",
            "maxCpu",
            "maxMemoryMib",
            "maxStorageGib"
          ],
          "type": "object"
        },
        "enforcementPolicy": {
          "enum": [
            "hard",
            "soft"
          ],
          "type": "string"
        },
        "perTypeCeilings": {
          "additionalProperties": {
            "type": "object"
          },
          "maxProperties": 64,
          "type": "object"
        },
        "providerRef": {
          "pattern": "^[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "scope": {
          "enum": [
            "zone"
          ],
          "type": "string"
        },
        "updatePolicy": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "automatic",
                "manual-disruptive"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [
        "ceilings",
        "perTypeCeilings",
        "scope",
        "enforcementPolicy"
      ],
      "type": "object"
    },
    "type": {
      "const": "Quota"
    }
  },
  "required": [
    "apiVersion",
    "metadata",
    "spec",
    "type"
  ],
  "title": "Quota",
  "type": "object"
}
