{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZoneStoreStorageRow",
  "description": "Complete closed storage row for one Zone resource store.",
  "type": "object",
  "required": [
    "auxiliaryDirectories",
    "filesystem",
    "fsync",
    "identity",
    "locking",
    "marker",
    "ownership",
    "parentDirectoryId",
    "publication",
    "replacementDetection",
    "storageOwnerPrincipal",
    "zoneStoreId"
  ],
  "properties": {
    "auxiliaryDirectories": {
      "description": "Explicit d2bd-owned audit and telemetry directory posture.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreAuxiliaryDirectories"
        }
      ]
    },
    "filesystem": {
      "description": "Required filesystem capability and path-resolution posture.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreFilesystemRequirement"
        }
      ]
    },
    "fsync": {
      "description": "Required file and parent-directory durability.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreFsyncRequirement"
        }
      ]
    },
    "identity": {
      "description": "Immutable Zone/store identity binding.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreIdentity"
        }
      ]
    },
    "locking": {
      "description": "Required locking capability.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreLockingRequirement"
        }
      ]
    },
    "marker": {
      "description": "Required identity marker.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreMarkerInvariant"
        }
      ]
    },
    "ownership": {
      "description": "Required owner, group, mode, and link-count posture.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreOwnershipInvariant"
        }
      ]
    },
    "parentDirectoryId": {
      "description": "Opaque identifier for its broker-resolved parent directory.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreParentDirectoryId"
        }
      ]
    },
    "publication": {
      "description": "Required crash-safe publication behavior.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStorePublicationInvariant"
        }
      ]
    },
    "replacementDetection": {
      "description": "Required replacement-detection behavior.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreReplacementDetection"
        }
      ]
    },
    "storageOwnerPrincipal": {
      "description": "Principal with authority to provision, validate, and open the store.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStorePrincipal"
        }
      ]
    },
    "zoneStoreId": {
      "description": "Opaque identifier for the database file.",
      "allOf": [
        {
          "$ref": "#/definitions/ZoneStoreId"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ResourceUid": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ZoneStoreAuxiliaryDirectories": {
      "description": "Broker-resolved directories used by the Zone runtime's audit and telemetry ports.",
      "type": "object",
      "required": [
        "audit",
        "telemetry"
      ],
      "properties": {
        "audit": {
          "description": "Durable authoritative audit directory.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreAuxiliaryDirectory"
            }
          ]
        },
        "telemetry": {
          "description": "Best-effort telemetry receiver directory.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreAuxiliaryDirectory"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ZoneStoreAuxiliaryDirectory": {
      "description": "Exact ownership and repair requirements for one Zone auxiliary directory.",
      "type": "object",
      "required": [
        "directoryId",
        "group",
        "mode",
        "owner",
        "repairOwner"
      ],
      "properties": {
        "directoryId": {
          "description": "Opaque identifier for the broker-resolved directory.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreDirectoryId"
            }
          ]
        },
        "group": {
          "description": "Required directory group.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStorePrincipal"
            }
          ]
        },
        "mode": {
          "description": "Required directory mode.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreFileMode"
            }
          ]
        },
        "owner": {
          "description": "Required directory owner.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStorePrincipal"
            }
          ]
        },
        "repairOwner": {
          "description": "Sole authority allowed to provision or repair this directory.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreDirectoryRepairOwner"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ZoneStoreDescriptorPublicationRequirement": {
      "description": "Required descriptor publication posture.",
      "oneOf": [
        {
          "description": "Publish only an owned descriptor verified close-on-exec before concurrency.",
          "type": "string",
          "enum": [
            "owned-descriptor-close-on-exec-verified-before-concurrency"
          ]
        }
      ]
    },
    "ZoneStoreDirectoryId": {
      "description": "Opaque auxiliary Zone-directory identifier resolved only by the storage owner.",
      "type": "string",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,159}$"
    },
    "ZoneStoreDirectoryRepairOwner": {
      "description": "The sole privileged repair authority for broker-provisioned Zone directories.",
      "oneOf": [
        {
          "description": "The privileged broker is the only component allowed to create or repair the declared directory posture.",
          "type": "string",
          "enum": [
            "privileged-broker"
          ]
        }
      ]
    },
    "ZoneStoreFileMode": {
      "type": "string",
      "maxLength": 4,
      "minLength": 4,
      "pattern": "^0[0-7]{3}$"
    },
    "ZoneStoreFilesystemRequirement": {
      "description": "Required filesystem posture for resolving and opening the database inode.",
      "oneOf": [
        {
          "description": "Resolve beneath the anchored parent and open a regular file without following links.",
          "type": "string",
          "enum": [
            "regular-file-anchored-fd-relative-no-follow"
          ]
        }
      ]
    },
    "ZoneStoreFsyncRequirement": {
      "description": "Required durability boundary for store creation and replacement.",
      "oneOf": [
        {
          "description": "Fsync the database file and its anchored parent directory.",
          "type": "string",
          "enum": [
            "database-and-parent-directory"
          ]
        }
      ]
    },
    "ZoneStoreId": {
      "description": "Opaque Zone store identifier resolved only by the storage owner.",
      "type": "string",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,159}$"
    },
    "ZoneStoreIdentity": {
      "description": "Immutable identity shared by the Zone self-resource and its store.",
      "type": "object",
      "required": [
        "storeEpoch",
        "storeUid",
        "zoneUid"
      ],
      "properties": {
        "storeEpoch": {
          "description": "Monotone identity epoch, advanced only when a store is reprovisioned.",
          "type": "integer",
          "format": "uint64",
          "minimum": 1.0
        },
        "storeUid": {
          "description": "Immutable UID of the physical Zone store.",
          "allOf": [
            {
              "$ref": "#/definitions/ResourceUid"
            }
          ]
        },
        "zoneUid": {
          "description": "Immutable UID of the Zone self-resource.",
          "allOf": [
            {
              "$ref": "#/definitions/ResourceUid"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ZoneStoreIdentityMarkerId": {
      "description": "Opaque identity-marker identifier resolved only by the storage owner.",
      "type": "string",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,159}$"
    },
    "ZoneStoreLinkCount": {
      "description": "Database inode link count, exactly one.",
      "type": "integer",
      "enum": [
        1
      ]
    },
    "ZoneStoreLockingRequirement": {
      "description": "Required lock primitive and descriptor inheritance posture.",
      "oneOf": [
        {
          "description": "Use an open-file-description lock whose descriptor is close-on-exec.",
          "type": "string",
          "enum": [
            "ofd-close-on-exec"
          ]
        }
      ]
    },
    "ZoneStoreMarkerInvariant": {
      "description": "Identity marker required before a store descriptor may be published.",
      "type": "object",
      "required": [
        "identityMarkerId"
      ],
      "properties": {
        "identityMarkerId": {
          "description": "Opaque broker-resolved identity marker.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreIdentityMarkerId"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ZoneStoreOwnershipInvariant": {
      "description": "Exact database-inode ownership and metadata requirements.",
      "type": "object",
      "required": [
        "group",
        "linkCount",
        "mode",
        "owner"
      ],
      "properties": {
        "group": {
          "description": "Required database inode group.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStorePrincipal"
            }
          ]
        },
        "linkCount": {
          "description": "Required database inode link count.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreLinkCount"
            }
          ]
        },
        "mode": {
          "description": "Required database inode mode.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreFileMode"
            }
          ]
        },
        "owner": {
          "description": "Required database inode owner.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStorePrincipal"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ZoneStoreParentDirectoryId": {
      "description": "Opaque parent-directory identifier resolved by the broker through an anchored descriptor.",
      "type": "string",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,159}$"
    },
    "ZoneStorePrincipal": {
      "description": "Validated local storage-owner, file-owner, or file-group principal.",
      "type": "string",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,159}$"
    },
    "ZoneStorePublicationInvariant": {
      "description": "Complete publication requirements for initial open and staged replacement.",
      "type": "object",
      "required": [
        "descriptor",
        "replacement"
      ],
      "properties": {
        "descriptor": {
          "description": "Required descriptor ownership, inheritance, and concurrency boundary.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreDescriptorPublicationRequirement"
            }
          ]
        },
        "replacement": {
          "description": "Required staged-replacement publication behavior.",
          "allOf": [
            {
              "$ref": "#/definitions/ZoneStoreReplacementPublicationRequirement"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ZoneStoreReplacementDetection": {
      "description": "Required response to missing, replaced, or identity-mismatched state.",
      "oneOf": [
        {
          "description": "Refuse the open rather than silently creating a replacement store.",
          "type": "string",
          "enum": [
            "fail-closed-on-missing-replaced-or-identity-mismatch"
          ]
        }
      ]
    },
    "ZoneStoreReplacementPublicationRequirement": {
      "description": "Required staged-replacement publication and ambiguous-recovery posture.",
      "oneOf": [
        {
          "description": "Atomically rename, retain the prior store, and quarantine ambiguity.",
          "type": "string",
          "enum": [
            "atomic-rename-retain-prior-quarantine-ambiguity"
          ]
        }
      ]
    }
  }
}
