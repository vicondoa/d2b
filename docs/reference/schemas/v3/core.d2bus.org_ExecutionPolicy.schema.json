{
  "$id": "https://d2bus.org/schemas/v3/core.d2bus.org_ExecutionPolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "CapabilityClass": {
      "description": "Semantic capability grant.",
      "enum": [
        "network-bind",
        "network-raw",
        "network-admin",
        "sys-time",
        "sys-ptrace",
        "sys-admin",
        "dac-override",
        "fowner",
        "chown",
        "setuid",
        "setgid",
        "audit-write",
        "kill"
      ],
      "type": "string"
    },
    "NamespaceClass": {
      "description": "Semantic namespace isolation request.",
      "enum": [
        "user",
        "pid",
        "mount",
        "ipc",
        "uts",
        "network",
        "cgroup",
        "time"
      ],
      "type": "string"
    },
    "PolicyCapabilities": {
      "additionalProperties": false,
      "description": "The Linux capabilities one policy admits.",
      "properties": {
        "allowed": {
          "items": {
            "$ref": "#/definitions/CapabilityClass"
          },
          "type": "array"
        }
      },
      "required": [
        "allowed"
      ],
      "type": "object"
    },
    "PolicyIdentity": {
      "additionalProperties": false,
      "description": "The identity rules one policy authorizes.",
      "properties": {
        "requireUserNamespace": {
          "type": "boolean"
        },
        "userRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceRef",
              "x-d2b-reference-kind": "ResourceRef",
              "x-d2b-reference-scope": "same-zone"
            },
            {
              "type": "null"
            }
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        }
      },
      "required": [
        "requireUserNamespace"
      ],
      "type": "object"
    },
    "PolicyNamespaces": {
      "additionalProperties": false,
      "description": "The isolation classes one policy requires.",
      "properties": {
        "classes": {
          "items": {
            "$ref": "#/definitions/NamespaceClass"
          },
          "type": "array"
        }
      },
      "required": [
        "classes"
      ],
      "type": "object"
    },
    "PolicyRoot": {
      "additionalProperties": false,
      "description": "The root-filesystem restrictions one policy mandates.",
      "properties": {
        "privateRoot": {
          "type": "boolean"
        },
        "readOnlyRoot": {
          "type": "boolean"
        }
      },
      "required": [
        "privateRoot",
        "readOnlyRoot"
      ],
      "type": "object"
    },
    "PolicySeccomp": {
      "additionalProperties": false,
      "description": "The syscall filter one policy selects.",
      "properties": {
        "profileRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceRef",
              "x-d2b-reference-kind": "ResourceRef",
              "x-d2b-reference-scope": "same-zone"
            },
            {
              "type": "null"
            }
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        }
      },
      "type": "object"
    },
    "ResourceRef": {
      "oneOf": [
        {
          "maxLength": 81,
          "minLength": 6,
          "pattern": "^(Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|VolumeBinding|Network|Device|CredentialBinding|DeviceBinding|User|Credential|Endpoint|ResourceExport|ResourceImport|Operation|SeccompProfile|ExecutionPolicy)/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "maxLength": 201,
          "minLength": 15,
          "pattern": "^[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      ],
      "x-d2b-reference-kind": "ResourceRef",
      "x-d2b-reference-scope": "same-zone"
    }
  },
  "description": "Confinement row: required isolation classes, the capability ceiling, mandatory restrictions, authorized identity, and the selected syscall filter. It grants no volume, device, network, endpoint, or credential access.",
  "properties": {
    "apiVersion": {
      "const": "resources.d2bus.org/v3"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value annotation map.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value label map.",
          "type": "object"
        },
        "name": {
          "description": "Zone-local resource name.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "ownerRef": {
          "description": "Optional same-Zone ref of the owning resource.",
          "pattern": "^(?:[A-Z][A-Za-z0-9]{0,62}|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "zone": {
          "description": "Name of the Zone this resource is local to.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "zone"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "description": "The `ExecutionPolicy` desired spec.\n\nThere is deliberately no volume, device, network, endpoint, credential, mount, or host-path field: resource access is admitted through the typed binding relationships, and a field here would reintroduce the independent attachment grant this resource replaces.",
      "properties": {
        "capabilities": {
          "$ref": "#/definitions/PolicyCapabilities"
        },
        "identity": {
          "$ref": "#/definitions/PolicyIdentity"
        },
        "namespaces": {
          "$ref": "#/definitions/PolicyNamespaces"
        },
        "noNewPrivileges": {
          "type": "boolean"
        },
        "providerRef": {
          "pattern": "^Provider/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [
            "Provider"
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "root": {
          "$ref": "#/definitions/PolicyRoot"
        },
        "seccomp": {
          "$ref": "#/definitions/PolicySeccomp"
        },
        "umask": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "updatePolicy": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "automatic",
                "manual-disruptive"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [
        "capabilities",
        "identity",
        "namespaces",
        "noNewPrivileges",
        "root",
        "seccomp"
      ],
      "title": "ExecutionPolicySpec",
      "type": "object"
    },
    "type": {
      "const": "ExecutionPolicy"
    }
  },
  "required": [
    "apiVersion",
    "metadata",
    "spec",
    "type"
  ],
  "title": "ExecutionPolicy",
  "type": "object",
  "x-d2b-resource-type": "ExecutionPolicy"
}
