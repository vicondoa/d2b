{
  "$id": "https://d2bus.org/schemas/v3/core.d2bus.org_Command.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "BoundedText": {
      "maxLength": 128,
      "minLength": 0,
      "type": "string"
    },
    "BoundedToken": {
      "maxLength": 63,
      "minLength": 1,
      "type": "string"
    },
    "CommandArgvSlot": {
      "description": "One argument slot: a literal, or a whole-slot {placeholder} naming a declared parameter.",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?:[^{}\\u0000-\\u001f\\u007f-\\u009f]+|\\{[a-z][a-zA-Z0-9]{0,62}\\})$",
      "type": "string"
    },
    "CommandExec": {
      "maxLength": 4096,
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "type": "string"
    },
    "CommandIntent": {
      "additionalProperties": false,
      "description": "The intent facet: how bundle entries map onto one command.",
      "properties": {
        "grammar": {
          "$ref": "#/definitions/BoundedText"
        },
        "mint": {
          "$ref": "#/definitions/BoundedToken"
        }
      },
      "required": [
        "grammar",
        "mint"
      ],
      "type": "object"
    },
    "PayloadSchema": {
      "description": "Closed payload JSON Schema: object-typed, additionalProperties=false, writeOnly properties carrying no default/enum/const/examples.",
      "type": "object"
    },
    "ResourceRef": {
      "oneOf": [
        {
          "maxLength": 80,
          "minLength": 6,
          "pattern": "^(Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|VolumeBinding|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|Command|Operation|SeccompProfile)/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "maxLength": 201,
          "minLength": 15,
          "pattern": "^[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      ],
      "x-d2b-reference-kind": "ResourceRef",
      "x-d2b-reference-scope": "same-zone"
    }
  },
  "description": "Declared launch shape: executable, argv placeholder slots, parameters, worker role, and intent.",
  "properties": {
    "apiVersion": {
      "const": "resources.d2bus.org/v3"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value annotation map.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional authored key-value label map.",
          "type": "object"
        },
        "name": {
          "description": "Zone-local resource name.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "ownerRef": {
          "description": "Optional same-Zone ref of the owning resource.",
          "pattern": "^(?:[A-Z][A-Za-z0-9]{0,62}|[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62})/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "zone": {
          "description": "Name of the Zone this resource is local to.",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "zone"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "description": "The `Command` desired spec.",
      "properties": {
        "argv": {
          "items": {
            "$ref": "#/definitions/CommandArgvSlot"
          },
          "type": "array"
        },
        "exec": {
          "$ref": "#/definitions/CommandExec"
        },
        "intent": {
          "$ref": "#/definitions/CommandIntent"
        },
        "params": {
          "$ref": "#/definitions/PayloadSchema"
        },
        "providerRef": {
          "pattern": "^Provider/[a-z][a-z0-9-]{0,62}$",
          "type": "string",
          "x-d2b-allowed-ref-types": [
            "Provider"
          ],
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "roleRef": {
          "$ref": "#/definitions/ResourceRef",
          "x-d2b-reference-kind": "ResourceRef",
          "x-d2b-reference-scope": "same-zone"
        },
        "updatePolicy": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "automatic",
                "manual-disruptive"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [
        "argv",
        "exec",
        "intent",
        "params",
        "roleRef"
      ],
      "title": "CommandSpec",
      "type": "object"
    },
    "type": {
      "const": "Command"
    }
  },
  "required": [
    "apiVersion",
    "metadata",
    "spec",
    "type"
  ],
  "title": "Command",
  "type": "object",
  "x-d2b-resource-type": "Command"
}
