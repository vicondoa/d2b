{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnsafeLocalHelperWireSchema",
  "description": "The complete helper wire schema: version plus both frame directions.",
  "type": "object",
  "required": [
    "daemonToHelper",
    "helperToDaemon",
    "protocolVersion"
  ],
  "properties": {
    "daemonToHelper": {
      "$ref": "#/definitions/DaemonToUnsafeLocalHelper"
    },
    "helperToDaemon": {
      "$ref": "#/definitions/UnsafeLocalHelperToDaemon"
    },
    "protocolVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BindingRealizationFacet": {
      "description": "The realization facet a requested presentation depends on.\n\nA presentation the selected backend cannot enforce is refused rather than skipped: an unapplied mount policy, an unclaimed device, or an unproven endpoint is not success.",
      "oneOf": [
        {
          "description": "A private mount tree carrying the exact named view at the destination.",
          "type": "string",
          "enum": [
            "filesystem-presentation"
          ]
        },
        {
          "description": "A block device in a consumer device slot.",
          "type": "string",
          "enum": [
            "consumer-device-slot"
          ]
        },
        {
          "description": "A verified device descriptor or mediated attachment.",
          "type": "string",
          "enum": [
            "device-attachment"
          ]
        },
        {
          "description": "An inherited interface in the consumer's own network namespace.",
          "type": "string",
          "enum": [
            "namespace-interface"
          ]
        },
        {
          "description": "Membership in the provider-owned shared fabric realization.",
          "type": "string",
          "enum": [
            "shared-fabric"
          ]
        },
        {
          "description": "A verified connected or listening descriptor for the exact endpoint.",
          "type": "string",
          "enum": [
            "endpoint-descriptor"
          ]
        },
        {
          "description": "A private binding of the exact socket where the backend needs a name.",
          "type": "string",
          "enum": [
            "endpoint-pathname"
          ]
        },
        {
          "description": "Credential material delivered inside an admitted delivery session.",
          "type": "string",
          "enum": [
            "credential-delivery"
          ]
        }
      ]
    },
    "DaemonToUnsafeLocalHelper": {
      "description": "One frame the daemon may send to the helper.",
      "oneOf": [
        {
          "description": "The greeting was accepted.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHelloAccepted"
            },
            "type": {
              "type": "string",
              "enum": [
                "helloAccepted"
              ]
            }
          }
        },
        {
          "description": "A liveness frame.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHeartbeat"
            },
            "type": {
              "type": "string",
              "enum": [
                "heartbeat"
              ]
            }
          }
        },
        {
          "description": "A launch request.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperLaunchRequest"
            },
            "type": {
              "type": "string",
              "enum": [
                "launch"
              ]
            }
          }
        }
      ]
    },
    "HelperFailureCode": {
      "description": "Closed failure code one helper operation can report.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "operation-id-conflict",
            "queue-full",
            "timeout",
            "user-manager-unavailable",
            "environment-invalid",
            "executable-unavailable",
            "scope-create-failed",
            "scope-identity-mismatch",
            "graphical-session-inactive",
            "wayland-unavailable",
            "proxy-unavailable",
            "first-client-timeout",
            "internal"
          ]
        },
        {
          "description": "The request was malformed or out of bounds.",
          "type": "string",
          "enum": [
            "invalid-request"
          ]
        },
        {
          "description": "The launch carried no admission the graph made, the admission did not verify, or it depends on a presentation this family cannot enforce.\n\nThe family is default-denied: an unsafe-local workload never starts because a transport asked it to, only because the graph admitted it.",
          "type": "string",
          "enum": [
            "graph-admission-required"
          ]
        },
        {
          "description": "The admission was made for a different subject than the one presenting it. The transport's own identity is evidence about the transport, never a stand-in for the requester.",
          "type": "string",
          "enum": [
            "requester-mismatch"
          ]
        }
      ]
    },
    "HelperGraphAdmission": {
      "description": "The graph decision that admitted one unsafe-local launch.\n\nA launch frame is a *request*; this value is the decision that made it admissible, and it is derived from the graph rather than from the transport that carries it. It names the committed consumer row the launch is fenced against (its Zone, store-assigned identity, and generation all move when the row is replaced or revised), the authenticated subject the admission was made for, the one posture this family runs under, and the presentation facets the launch depends on.\n\nThe presentation set is the load-bearing half. This family has no mount namespace, so it realizes no destination and no named view: an admission that depends on any presentation facet cannot be enforced here and is refused before the workload starts rather than launched with the property silently dropped (R20, R27, AE19).",
      "type": "object",
      "required": [
        "admissionDigest",
        "posture",
        "presentation",
        "requesterUid",
        "workload"
      ],
      "properties": {
        "admissionDigest": {
          "type": "string"
        },
        "posture": {
          "$ref": "#/definitions/UnsafeLocalPosture"
        },
        "presentation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BindingRealizationFacet"
          }
        },
        "requesterUid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "workload": {
          "$ref": "#/definitions/ZoneResourceIdentity"
        }
      },
      "additionalProperties": false
    },
    "HelperHeartbeat": {
      "description": "Liveness frame carrying the generation and a monotonic sequence.",
      "type": "object",
      "required": [
        "generation",
        "sequence"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperHello": {
      "description": "Helper-to-daemon greeting naming the protocol version and generation.",
      "type": "object",
      "required": [
        "generation",
        "protocolVersion"
      ],
      "properties": {
        "features": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProtocolToken"
          }
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperHelloAccepted": {
      "description": "Daemon-to-helper acceptance of a greeting, pinning interval bounds.",
      "type": "object",
      "required": [
        "generation",
        "heartbeatIntervalSecs",
        "operationTimeoutSecs",
        "protocolVersion"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "heartbeatIntervalSecs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "operationTimeoutSecs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperLaunchRequest": {
      "description": "One launch request the daemon commits to the helper.\n\nThe launch is admissible only under the [`HelperGraphAdmission`] it carries. The field is required, so a frame written before the admission existed does not decode into a launch at all, and the requester's identity is the one the graph admitted rather than one a transport can assert.\n\nThe workload target, item id, argv, and requester are redacted in `Debug`.",
      "type": "object",
      "required": [
        "admission",
        "argv",
        "graphical",
        "itemId",
        "operationId",
        "realmAccentColor",
        "requestId",
        "target",
        "workload"
      ],
      "properties": {
        "admission": {
          "$ref": "#/definitions/HelperGraphAdmission"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graphical": {
          "type": "boolean"
        },
        "itemId": {
          "$ref": "#/definitions/ProtocolToken"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "realmAccentColor": {
          "type": "string"
        },
        "requestId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "target": {
          "$ref": "#/definitions/RealmTarget"
        },
        "workload": {
          "$ref": "#/definitions/ZoneResourceIdentity"
        }
      },
      "additionalProperties": false
    },
    "HelperOperationDisposition": {
      "description": "How a helper operation settled.",
      "oneOf": [
        {
          "description": "The operation was newly committed.",
          "type": "string",
          "enum": [
            "committed"
          ]
        },
        {
          "description": "The operation was already committed before.",
          "type": "string",
          "enum": [
            "already-committed"
          ]
        },
        {
          "description": "The operation finished.",
          "type": "string",
          "enum": [
            "completed"
          ]
        }
      ]
    },
    "HelperOperationRejected": {
      "description": "Refusal of one helper operation with its closed failure code.",
      "type": "object",
      "required": [
        "code",
        "operationId",
        "requestId"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/HelperFailureCode"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "requestId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperOperationResult": {
      "description": "Outcome of one committed helper operation.",
      "type": "object",
      "required": [
        "disposition",
        "operationId",
        "requestId"
      ],
      "properties": {
        "disposition": {
          "$ref": "#/definitions/HelperOperationDisposition"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "requestId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/ScopeIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HelperScopeKind": {
      "description": "The kind of workload scope the helper runs.",
      "oneOf": [
        {
          "description": "A launcher application scope.",
          "type": "string",
          "enum": [
            "launcher-app"
          ]
        },
        {
          "description": "A Wayland proxy scope.",
          "type": "string",
          "enum": [
            "wayland-proxy"
          ]
        }
      ]
    },
    "HelperScopeSnapshot": {
      "description": "One scope's observed state in a helper snapshot.",
      "type": "object",
      "required": [
        "operationId",
        "scope",
        "state",
        "workload"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "scope": {
          "$ref": "#/definitions/ScopeIdentity"
        },
        "state": {
          "$ref": "#/definitions/HelperScopeState"
        },
        "workload": {
          "$ref": "#/definitions/ZoneResourceIdentity"
        }
      },
      "additionalProperties": false
    },
    "HelperScopeState": {
      "description": "Lifecycle state of one helper scope.",
      "oneOf": [
        {
          "description": "The scope is being set up.",
          "type": "string",
          "enum": [
            "starting"
          ]
        },
        {
          "description": "The scope is serving.",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "The scope is tearing down.",
          "type": "string",
          "enum": [
            "stopping"
          ]
        },
        {
          "description": "The scope has exited.",
          "type": "string",
          "enum": [
            "exited"
          ]
        },
        {
          "description": "The scope is serving degraded.",
          "type": "string",
          "enum": [
            "degraded"
          ]
        }
      ]
    },
    "HelperSnapshot": {
      "description": "Bounded snapshot of every scope the helper currently runs.",
      "type": "object",
      "required": [
        "generation",
        "scopes"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HelperScopeSnapshot"
          }
        }
      },
      "additionalProperties": false
    },
    "OperationId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ProtocolToken": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "RealmTarget": {
      "type": "string",
      "maxLength": 388,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+\\.d2b$"
    },
    "ResourceGeneration": {
      "type": "integer",
      "minimum": 1.0
    },
    "ResourceRef": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 81,
          "minLength": 6,
          "pattern": "^(Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|VolumeBinding|Network|Device|CredentialBinding|DeviceBinding|User|Credential|Endpoint|ResourceExport|ResourceImport|Operation|SeccompProfile|EndpointBinding|ExecutionPolicy)/[a-z][a-z0-9-]{0,62}$"
        },
        {
          "type": "string",
          "maxLength": 201,
          "minLength": 15,
          "pattern": "^[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$"
        }
      ]
    },
    "ResourceUid": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ScopeIdentity": {
      "description": "Opaque identity of one helper scope; the invocation id is redacted.",
      "type": "object",
      "required": [
        "invocationId",
        "kind"
      ],
      "properties": {
        "invocationId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/HelperScopeKind"
        }
      },
      "additionalProperties": false
    },
    "UnsafeLocalHelperToDaemon": {
      "description": "One frame the helper may send to the daemon.",
      "oneOf": [
        {
          "description": "The initial greeting.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHello"
            },
            "type": {
              "type": "string",
              "enum": [
                "hello"
              ]
            }
          }
        },
        {
          "description": "A scope snapshot.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperSnapshot"
            },
            "type": {
              "type": "string",
              "enum": [
                "snapshot"
              ]
            }
          }
        },
        {
          "description": "A liveness frame.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHeartbeat"
            },
            "type": {
              "type": "string",
              "enum": [
                "heartbeat"
              ]
            }
          }
        },
        {
          "description": "A committed operation outcome.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperOperationResult"
            },
            "type": {
              "type": "string",
              "enum": [
                "operation"
              ]
            }
          }
        },
        {
          "description": "A refused operation.",
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperOperationRejected"
            },
            "type": {
              "type": "string",
              "enum": [
                "rejected"
              ]
            }
          }
        }
      ]
    },
    "UnsafeLocalPosture": {
      "description": "The isolation posture one admitted unsafe-local launch runs under.\n\nThe vocabulary is deliberately closed and has exactly one member. An unsafe-local `Host` is an explicit *no-isolation* target: it runs the workload with the admitted requester's own host identity and no namespace, mount, capability, or syscall confinement. Naming that posture here keeps the no-isolation meaning a declared value rather than an absence, and it leaves exactly one place to add a confinement this family would later enforce - it never leaves room for a launch that carries no posture at all.",
      "oneOf": [
        {
          "description": "No isolation: the requester's own identity, no confinement.",
          "type": "string",
          "enum": [
            "explicit-no-isolation"
          ]
        }
      ]
    },
    "ZoneId": {
      "type": "string",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "ZoneResourceIdentity": {
      "description": "Immutable identity for a resource in one Zone generation.\n\nThe Zone UID and resource UID are both required because a name or a Zone label alone can be reused after deletion or across independent Zones. `generation` fences desired-state changes and `revision` fences the committed Zone view that authorized the identity.",
      "type": "object",
      "required": [
        "generation",
        "resourceRef",
        "resourceUid",
        "revision",
        "zone",
        "zoneUid"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/ResourceGeneration"
        },
        "resourceRef": {
          "$ref": "#/definitions/ResourceRef"
        },
        "resourceUid": {
          "$ref": "#/definitions/ResourceUid"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "zone": {
          "$ref": "#/definitions/ZoneId"
        },
        "zoneUid": {
          "$ref": "#/definitions/ResourceUid"
        }
      },
      "additionalProperties": false
    }
  }
}
