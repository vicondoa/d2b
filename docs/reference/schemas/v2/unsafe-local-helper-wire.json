{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnsafeLocalHelperWireSchema",
  "type": "object",
  "required": [
    "daemonToHelper",
    "helperToDaemon",
    "protocolVersion"
  ],
  "properties": {
    "daemonToHelper": {
      "$ref": "#/definitions/DaemonToUnsafeLocalHelper"
    },
    "helperToDaemon": {
      "$ref": "#/definitions/UnsafeLocalHelperToDaemon"
    },
    "protocolVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DaemonToUnsafeLocalHelper": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHelloAccepted"
            },
            "type": {
              "type": "string",
              "enum": [
                "helloAccepted"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHeartbeat"
            },
            "type": {
              "type": "string",
              "enum": [
                "heartbeat"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperLaunchRequest"
            },
            "type": {
              "type": "string",
              "enum": [
                "launch"
              ]
            }
          }
        }
      ]
    },
    "HelperFailureCode": {
      "type": "string",
      "enum": [
        "invalid-request",
        "operation-id-conflict",
        "queue-full",
        "timeout",
        "user-manager-unavailable",
        "environment-invalid",
        "executable-unavailable",
        "scope-create-failed",
        "scope-identity-mismatch",
        "graphical-session-inactive",
        "wayland-unavailable",
        "proxy-unavailable",
        "first-client-timeout",
        "internal"
      ]
    },
    "HelperHeartbeat": {
      "type": "object",
      "required": [
        "generation",
        "sequence"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperHello": {
      "type": "object",
      "required": [
        "generation",
        "protocolVersion"
      ],
      "properties": {
        "features": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProtocolToken"
          }
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperHelloAccepted": {
      "type": "object",
      "required": [
        "generation",
        "heartbeatIntervalSecs",
        "operationTimeoutSecs",
        "protocolVersion"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "heartbeatIntervalSecs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "operationTimeoutSecs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperLaunchRequest": {
      "type": "object",
      "required": [
        "argv",
        "graphical",
        "itemId",
        "operationId",
        "realmAccentColor",
        "requestId",
        "target",
        "workload"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graphical": {
          "type": "boolean"
        },
        "itemId": {
          "$ref": "#/definitions/ProtocolToken"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "realmAccentColor": {
          "type": "string"
        },
        "requestId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "target": {
          "$ref": "#/definitions/RealmTarget"
        },
        "workload": {
          "$ref": "#/definitions/ZoneResourceIdentity"
        }
      },
      "additionalProperties": false
    },
    "HelperOperationDisposition": {
      "type": "string",
      "enum": [
        "committed",
        "already-committed",
        "completed"
      ]
    },
    "HelperOperationRejected": {
      "type": "object",
      "required": [
        "code",
        "operationId",
        "requestId"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/HelperFailureCode"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "requestId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "HelperOperationResult": {
      "type": "object",
      "required": [
        "disposition",
        "operationId",
        "requestId"
      ],
      "properties": {
        "disposition": {
          "$ref": "#/definitions/HelperOperationDisposition"
        },
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "requestId": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/ScopeIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HelperScopeKind": {
      "type": "string",
      "enum": [
        "launcher-app",
        "wayland-proxy"
      ]
    },
    "HelperScopeSnapshot": {
      "type": "object",
      "required": [
        "operationId",
        "scope",
        "state",
        "workload"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "scope": {
          "$ref": "#/definitions/ScopeIdentity"
        },
        "state": {
          "$ref": "#/definitions/HelperScopeState"
        },
        "workload": {
          "$ref": "#/definitions/ZoneResourceIdentity"
        }
      },
      "additionalProperties": false
    },
    "HelperScopeState": {
      "type": "string",
      "enum": [
        "starting",
        "active",
        "stopping",
        "exited",
        "degraded"
      ]
    },
    "HelperSnapshot": {
      "type": "object",
      "required": [
        "generation",
        "scopes"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HelperScopeSnapshot"
          }
        }
      },
      "additionalProperties": false
    },
    "OperationId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ProtocolToken": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "RealmTarget": {
      "type": "string",
      "maxLength": 388,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+\\.d2b$"
    },
    "ResourceGeneration": {
      "type": "integer",
      "minimum": 1.0
    },
    "ResourceRef": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 80,
          "minLength": 6,
          "pattern": "^(Zone|ZoneLink|Provider|Role|RoleBinding|Quota|EmergencyPolicy|Host|Guest|Process|EphemeralProcess|Volume|VolumeBinding|Network|Device|User|Credential|Endpoint|ResourceExport|ResourceImport|Command|Operation|SeccompProfile)/[a-z][a-z0-9-]{0,62}$"
        },
        {
          "type": "string",
          "maxLength": 201,
          "minLength": 15,
          "pattern": "^[a-z][a-z0-9-]{0,62}\\.d2bus\\.org\\.[A-Z][A-Za-z0-9]{0,62}/[a-z][a-z0-9-]{0,62}$"
        }
      ]
    },
    "ResourceUid": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ScopeIdentity": {
      "type": "object",
      "required": [
        "invocationId",
        "kind"
      ],
      "properties": {
        "invocationId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/HelperScopeKind"
        }
      },
      "additionalProperties": false
    },
    "UnsafeLocalHelperToDaemon": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHello"
            },
            "type": {
              "type": "string",
              "enum": [
                "hello"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperSnapshot"
            },
            "type": {
              "type": "string",
              "enum": [
                "snapshot"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperHeartbeat"
            },
            "type": {
              "type": "string",
              "enum": [
                "heartbeat"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperOperationResult"
            },
            "type": {
              "type": "string",
              "enum": [
                "operation"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "payload",
            "type"
          ],
          "properties": {
            "payload": {
              "$ref": "#/definitions/HelperOperationRejected"
            },
            "type": {
              "type": "string",
              "enum": [
                "rejected"
              ]
            }
          }
        }
      ]
    },
    "ZoneId": {
      "type": "string",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "ZoneResourceIdentity": {
      "description": "Immutable identity for a resource in one Zone generation.\n\nThe Zone UID and resource UID are both required because a name or a Zone label alone can be reused after deletion or across independent Zones. `generation` fences desired-state changes and `revision` fences the committed Zone view that authorized the identity.",
      "type": "object",
      "required": [
        "generation",
        "resourceRef",
        "resourceUid",
        "revision",
        "zone",
        "zoneUid"
      ],
      "properties": {
        "generation": {
          "$ref": "#/definitions/ResourceGeneration"
        },
        "resourceRef": {
          "$ref": "#/definitions/ResourceRef"
        },
        "resourceUid": {
          "$ref": "#/definitions/ResourceUid"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "zone": {
          "$ref": "#/definitions/ZoneId"
        },
        "zoneUid": {
          "$ref": "#/definitions/ResourceUid"
        }
      },
      "additionalProperties": false
    }
  }
}
