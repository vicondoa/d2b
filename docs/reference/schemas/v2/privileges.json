{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivilegesJson",
  "description": "Authorization matrix artifact for public API and private broker operations.",
  "type": "object",
  "required": [
    "brokerOperations",
    "publicOperations",
    "schemaVersion"
  ],
  "properties": {
    "brokerOperations": {
      "description": "Private broker authorization rows.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/OperationAuthz"
      }
    },
    "publicOperations": {
      "description": "Public CLI/API authorization rows.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/OperationAuthz"
      }
    },
    "schemaVersion": {
      "description": "Schema version used by this artifact.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AuditMode": {
      "description": "Audit mode for compact policy rows.",
      "type": "string",
      "enum": [
        "deny-only",
        "errors",
        "yes"
      ]
    },
    "AuditPolicy": {
      "description": "Audit requirement for an authorization row.",
      "type": "object",
      "required": [
        "mode",
        "required",
        "retainedFields"
      ],
      "properties": {
        "mode": {
          "description": "Whether deny-only or error-only auditing is sufficient.",
          "allOf": [
            {
              "$ref": "#/definitions/AuditMode"
            }
          ]
        },
        "required": {
          "description": "Whether a successful operation must emit an audit event.",
          "type": "boolean"
        },
        "retainedFields": {
          "description": "Field names retained in the audit event.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "BrokerRequirement": {
      "description": "Broker-use class for an authorization row.",
      "type": "string",
      "enum": [
        "no",
        "no-mutation",
        "conditional",
        "yes"
      ]
    },
    "DefaultForUnknown": {
      "description": "Required default for any unknown operation.",
      "type": "string",
      "enum": [
        "deny-and-audit"
      ]
    },
    "Destructive": {
      "description": "Destructive class for an authorization row.",
      "oneOf": [
        {
          "description": "No state mutation, teardown, rollback, GC, or live routing change.",
          "type": "string",
          "enum": [
            "no"
          ]
        },
        {
          "description": "State mutation, teardown, rollback, GC, or live routing changes are possible.",
          "type": "string",
          "enum": [
            "yes"
          ]
        }
      ]
    },
    "OperationAuthz": {
      "description": "One explicit authorization row; unknown future operations always deny.",
      "type": "object",
      "required": [
        "allowedGroups",
        "audit",
        "brokerRequired",
        "defaultForUnknown",
        "destructive",
        "operation",
        "scope",
        "secretAccess",
        "subject"
      ],
      "properties": {
        "allowedGroups": {
          "description": "Groups allowed to invoke the operation; empty denies by default.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit": {
          "description": "Audit event requirement and retained fields.",
          "allOf": [
            {
              "$ref": "#/definitions/AuditPolicy"
            }
          ]
        },
        "brokerRequired": {
          "description": "Whether the private broker is required or conditionally used.",
          "allOf": [
            {
              "$ref": "#/definitions/BrokerRequirement"
            }
          ]
        },
        "defaultForUnknown": {
          "description": "Default policy for unknown/future operations.",
          "allOf": [
            {
              "$ref": "#/definitions/DefaultForUnknown"
            }
          ]
        },
        "destructive": {
          "description": "Whether state mutation, teardown, rollback, GC, or live routing changes are possible.",
          "allOf": [
            {
              "$ref": "#/definitions/Destructive"
            }
          ]
        },
        "operation": {
          "description": "Stable operation enum or command name.",
          "type": "string",
          "enum": [
            "ApplyHostGenerationHandoff",
            "ApplyNftables",
            "ApplyNftablesProjection",
            "ApplyNmUnmanaged",
            "ApplyRoute",
            "ApplySysctl",
            "CgroupKill",
            "CheckSystemdUserManager",
            "CreateBridge",
            "CreateOrReconcileUsersGroups",
            "CreatePersistentTap",
            "CreateTapFd",
            "DelegateCgroupV2",
            "DeleteBridge",
            "DeletePersistentTap",
            "DeregisterRunnerPidfd",
            "DiskInit",
            "EnvelopeInvoke",
            "ExportBrokerAudit",
            "Hello",
            "InjectSecretById",
            "LaunchMinijailChild",
            "ModprobeIfAllowed",
            "ObserveRunner",
            "ObserveSystemdUnit",
            "OpenCgroupDir",
            "OpenDevice",
            "OpenFuse",
            "OpenHidrawSecurityKey",
            "OpenKvm",
            "OpenPeerPidfdFromAcceptedSocket",
            "OpenPidfd",
            "OpenSystemdUnitPidfd",
            "OpenVhostNet",
            "OwnershipMatrixCheck",
            "PipeWireAudio",
            "PollChildReaped",
            "PrepareRuntimeDir",
            "PrepareStateDir",
            "PrepareSwtpmDir",
            "PublishTrustedContext",
            "QemuMediaAttach",
            "QemuMediaBoot",
            "QemuMediaDetach",
            "QemuMediaEnroll",
            "QemuMediaQueryStatus",
            "QemuMediaQuit",
            "QemuMediaRefreshRegistry",
            "QemuMediaSystemPowerdown",
            "ReadSecretById",
            "ReconcileStorageScope",
            "RotateSecretById",
            "SecurityKeyApplyUdevRules",
            "SecurityKeyOpenDevice",
            "SeedDnsmasqLease",
            "SetBridgePortFlags",
            "SignalRunner",
            "SpawnRunner",
            "SshHostKeyPreflight",
            "StartSystemdUnit",
            "StopSystemdUnit",
            "StoreSync",
            "UpdateHostsFile",
            "UsbipBind",
            "UsbipBindFirewallRule",
            "UsbipExplicitBind",
            "UsbipExplicitFirewallRule",
            "UsbipProxyReconcile",
            "UsbipUnbind",
            "ValidateLockSpec",
            "activation",
            "apply-nftables",
            "apply-nftables-projection",
            "apply-nm-unmanaged",
            "apply-route",
            "apply-sysctl",
            "audio",
            "audio mic",
            "audio off",
            "audio on",
            "audio speaker",
            "audio status",
            "audit",
            "audit --human",
            "audit --json",
            "auth status",
            "boot",
            "build",
            "capabilities",
            "clipboard",
            "complete-cell",
            "config",
            "console",
            "consume-cell",
            "create-bridge",
            "create-persistent-tap",
            "create-tap-fd",
            "debug bundle",
            "delegate-cgroup-v2",
            "delete-bridge",
            "delete-persistent-tap",
            "deregister-pidfd",
            "device",
            "display",
            "down",
            "exec",
            "generations",
            "guest",
            "hello",
            "host destroy --apply",
            "host destroy --dry-run",
            "host doctor --read-only",
            "host prepare",
            "host prepare --apply",
            "host prepare --dry-run",
            "host reconcile-otel-acls --apply",
            "host shutdown-hook --apply",
            "inspect-process-family",
            "keys rotate",
            "kill-cgroup",
            "launch",
            "list",
            "observe-process",
            "op",
            "open-cgroup-dir",
            "open-peer-pidfd-from-accepted-socket",
            "open-pidfd",
            "poll-child-reaped",
            "prepare-directory",
            "realm",
            "resource",
            "restart",
            "rollback",
            "seed-dnsmasq-lease",
            "set-bridge-port-flags",
            "shell",
            "signal-pidfd",
            "spawn-process",
            "status",
            "status --check-bridges",
            "switch",
            "take-controller-bootstrap",
            "test",
            "up",
            "update-hosts-file",
            "usb",
            "usb attach",
            "usb detach",
            "usb probe",
            "usb security-key",
            "vm",
            "vm display"
          ]
        },
        "scope": {
          "description": "Per-VM, per-env, per-role, per-busid, scoped, or global resource scope.",
          "type": "string"
        },
        "secretAccess": {
          "description": "Whether secret or key material can be read or modified.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretAccess"
            }
          ]
        },
        "subject": {
          "description": "VM, env, host, key, bundle, daemon, or global subject.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SecretAccess": {
      "description": "Secret exposure class for an authorization row.",
      "type": "string",
      "enum": [
        "none",
        "public-key-only",
        "redacted-only",
        "metadata-only",
        "possible-paths-only",
        "host-key-metadata",
        "read-write"
      ]
    }
  }
}
