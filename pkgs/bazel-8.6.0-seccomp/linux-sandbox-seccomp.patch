+static bool D2BHasSocketOrRing(int fd) {
+  struct stat statbuf;
+  if (fstat(fd, &statbuf) < 0) {
+    return true;
+  }
+  if (S_ISSOCK(statbuf.st_mode)) {
+    return true;
+  }
+  char link[128];
+  const ssize_t length =
+      readlink(("/proc/self/fd/" + std::to_string(fd)).c_str(), link,
+               sizeof(link) - 1);
+  if (length <= 0) {
+    return true;
+  }
+  link[length] = '\0';
+  return strstr(link, "anon_inode:[io_uring]") != nullptr;
+}
+
+static bool D2BInheritedDescriptorPreflight() {
+  DIR *fds = opendir("/proc/self/fd");
+  if (fds == nullptr) {
+    return false;
+  }
+  bool valid = true;
+  while (true) {
+    errno = 0;
+    struct dirent *entry = readdir(fds);
+    if (entry == nullptr) {
+      if (errno != 0) {
+        valid = false;
+      }
+      break;
+    }
+    char *end = nullptr;
+    const long fd = strtol(entry->d_name, &end, 10);
+    if (end == entry->d_name || *end != '\0' || fd < 0 ||
+        fd == dirfd(fds)) {
+      continue;
+    }
+    if (D2BHasSocketOrRing(static_cast<int>(fd))) {
+      valid = false;
+      break;
+    }
+  }
+  closedir(fds);
+  return valid;
+}
+
+static std::string D2BPolicyPath() {
+  /*
+   * The immutable Bazel wrapper sets this to the policy installed in the
+   * same output. Missing or empty input is a refusal; there is no
+   * executable-link, ambient path, or policy-open fallback.
+   */
+  const char *policy_path = getenv("D2B_BAZEL_SECCOMP_POLICY");
+  if (policy_path == nullptr || policy_path[0] == '\0') {
+    return std::string();
+  }
+  return std::string(policy_path);
+}
+
+static bool D2BPolicyIdentityMatches() {
+  const std::string path = D2BPolicyPath();
+  if (path.empty()) {
+    return false;
+  }
+  const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+  if (fd < 0) {
+    return false;
+  }
+  char contents[8192];
+  const ssize_t length = read(fd, contents, sizeof(contents) - 1);
+  close(fd);
+  if (length <= 0) {
+    return false;
+  }
+  contents[length] = '\0';
+  return strstr(contents, kD2BPolicyAbi) != nullptr &&
+         strstr(contents, kD2BPolicyAbiSha256) != nullptr &&
+         strstr(contents, "\"futureChildPidMatching\": false") != nullptr &&
+         strstr(contents, "\"noFallback\": true") != nullptr &&
+         strstr(contents, "\"rejectedBeforeDispatch\": true") != nullptr;
+}
+
+static void D2BAddLoad(std::vector<struct sock_filter> *filter,
+                       unsigned int offset) {
+  filter->push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offset));
+}
+
+static size_t D2BAddEqual(std::vector<struct sock_filter> *filter,
+                          unsigned int value,
+                          std::vector<size_t> *failure_jumps) {
+  const size_t position = filter->size();
+  filter->push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, value, 0, 0));
+  failure_jumps->push_back(position);
+  return position;
+}
+
+static void D2BAddPointerEqual(
+    std::vector<struct sock_filter> *filter, unsigned int offset,
+    unsigned int value, std::vector<size_t> *failure_jumps) {
+  D2BAddLoad(filter, offset + sizeof(uint32_t));
+  D2BAddEqual(filter, 0, failure_jumps);
+  D2BAddLoad(filter, offset);
+  D2BAddEqual(filter, value, failure_jumps);
+}
+
+static void D2BAddPidEqual(std::vector<struct sock_filter> *filter,
+                           unsigned int value,
+                           std::vector<size_t> *failure_jumps) {
+  D2BAddLoad(filter, offsetof(struct seccomp_data, args[1]) + sizeof(uint32_t));
+  D2BAddEqual(filter, 0, failure_jumps);
+  D2BAddLoad(filter, offsetof(struct seccomp_data, args[1]));
+  D2BAddEqual(filter, value, failure_jumps);
+}
+
+static bool D2BInstallFilter() {
+  std::vector<struct sock_filter> filter;
+  filter.push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+                            offsetof(struct seccomp_data, arch)));
+#if defined(__x86_64__)
+  const unsigned int expected_arch = AUDIT_ARCH_X86_64;
+#elif defined(__aarch64__)
+  const unsigned int expected_arch = AUDIT_ARCH_AARCH64;
+#else
+  return false;
+#endif
+  filter.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, expected_arch, 1, 0));
+  filter.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS));
+
+#if defined(__x86_64__) && defined(__X32_SYSCALL_BIT)
+  /*
+   * x32 uses the x86-64 audit architecture but sets a high syscall-number
+   * bit. Reject it before the request and no-network tables so an x32
+   * syscall cannot fall through to the default allow action.
+   */
+  filter.push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+                            offsetof(struct seccomp_data, nr)));
+  filter.push_back(BPF_JUMP(BPF_JMP | BPF_JSET | BPF_K,
+                            __X32_SYSCALL_BIT, 0, 1));
+  filter.push_back(
+      BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | EACCES));
+#endif
+
+  std::vector<struct sock_filter> ptrace_rules;
+  ptrace_rules.push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+                                  offsetof(struct seccomp_data, nr)));
+  const size_t ptrace_jump = ptrace_rules.size();
+  ptrace_rules.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_ptrace, 0,
+                                   0));
+
+  std::vector<size_t> request_jumps;
+  std::vector<size_t> argument_failures;
+  struct PtraceRule {
+    unsigned int request;
+    bool pid_is_zero;
+    unsigned int data;
+  };
+  const PtraceRule rules[] = {
+      {PTRACE_TRACEME, true, 0},
+      {PTRACE_SETOPTIONS, false, PTRACE_O_TRACEEXEC},
+      {PTRACE_CONT, false, 0},
+      {PTRACE_DETACH, false, 0},
+  };
+  for (const PtraceRule &rule : rules) {
+    D2BAddLoad(&ptrace_rules, offsetof(struct seccomp_data, args[0]));
+    const size_t request_position = ptrace_rules.size();
+    ptrace_rules.push_back(
+        BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, rule.request, 0, 0));
+    request_jumps.push_back(request_position);
+    if (rule.pid_is_zero) {
+      D2BAddPidEqual(&ptrace_rules, 0, &argument_failures);
+    }
+    D2BAddPointerEqual(&ptrace_rules, offsetof(struct seccomp_data, args[2]), 0,
+                       &argument_failures);
+    D2BAddPointerEqual(&ptrace_rules, offsetof(struct seccomp_data, args[3]),
+                       rule.data, &argument_failures);
+    ptrace_rules.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW));
+  }
+  const size_t ptrace_deny = ptrace_rules.size();
+  ptrace_rules.push_back(
+      BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | EACCES));
+  for (size_t i = 0; i < request_jumps.size(); ++i) {
+    const size_t target =
+        i + 1 < request_jumps.size() ? request_jumps[i + 1] : ptrace_deny;
+    ptrace_rules[request_jumps[i]].jf =
+        static_cast<unsigned char>(target - request_jumps[i] - 1);
+  }
+  for (size_t position : argument_failures) {
+    ptrace_rules[position].jf =
+        static_cast<unsigned char>(ptrace_deny - position - 1);
+  }
+  ptrace_rules[ptrace_jump].jt = 0;
+  ptrace_rules[ptrace_jump].jf = static_cast<unsigned char>(
+      ptrace_rules.size() - ptrace_jump - 1);
+  filter.insert(filter.end(), ptrace_rules.begin(), ptrace_rules.end());
+
+  const int denied_syscalls[] = {
+#ifdef __NR_socket
+      __NR_socket,
+#endif
+#ifdef __NR_socketpair
+      __NR_socketpair,
+#endif
+#ifdef __NR_connect
+      __NR_connect,
+#endif
+#ifdef __NR_bind
+      __NR_bind,
+#endif
+#ifdef __NR_listen
+      __NR_listen,
+#endif
+#ifdef __NR_accept
+      __NR_accept,
+#endif
+#ifdef __NR_accept4
+      __NR_accept4,
+#endif
+#ifdef __NR_sendto
+      __NR_sendto,
+#endif
+#ifdef __NR_sendmsg
+      __NR_sendmsg,
+#endif
+#ifdef __NR_sendmmsg
+      __NR_sendmmsg,
+#endif
+#ifdef __NR_recvfrom
+      __NR_recvfrom,
+#endif
+#ifdef __NR_recvmsg
+      __NR_recvmsg,
+#endif
+#ifdef __NR_recvmmsg
+      __NR_recvmmsg,
+#endif
+#ifdef __NR_shutdown
+      __NR_shutdown,
+#endif
+#ifdef __NR_getsockname
+      __NR_getsockname,
+#endif
+#ifdef __NR_getpeername
+      __NR_getpeername,
+#endif
+#ifdef __NR_setsockopt
+      __NR_setsockopt,
+#endif
+#ifdef __NR_getsockopt
+      __NR_getsockopt,
+#endif
+#ifdef __NR_pidfd_getfd
+      __NR_pidfd_getfd,
+#endif
+#ifdef __NR_io_uring_setup
+      __NR_io_uring_setup,
+#endif
+#ifdef __NR_io_uring_enter
+      __NR_io_uring_enter,
+#endif
+#ifdef __NR_io_uring_register
+      __NR_io_uring_register,
+#endif
+#ifdef __NR_socketcall
+      __NR_socketcall,
+#endif
+  };
+  for (const int syscall_number : denied_syscalls) {
+    filter.push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+                               offsetof(struct seccomp_data, nr)));
+    filter.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K,
+                              static_cast<unsigned int>(syscall_number), 0, 1));
+    filter.push_back(
+        BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | EACCES));
+  }
+  filter.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW));
+
+  if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0) {
+    return false;
+  }
+  struct sock_fprog program = {
+      static_cast<unsigned short>(filter.size()), filter.data()};
+  return prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &program, 0, 0) == 0;
+}
