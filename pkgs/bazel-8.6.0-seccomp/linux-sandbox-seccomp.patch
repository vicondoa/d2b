+/*
+ * D2B action policy
+ *
+ * The policy is loaded by namespace PID 1 after mount, user, PID, and
+ * networking setup and before the action command is forked.  The installed
+ * JSON is an immutable identity input.  The filter below is deliberately
+ * closed: it retains the no-network denial set and admits only the four
+ * ptrace requests whose constant arguments classic seccomp can enforce.
+ * The future child pid is intentionally not compared here.  It is a dynamic
+ * identity owned by the supervisor's fork result, process-group check,
+ * direct-parent relation, initial trace stop, sole wait, and exec event.
+ * Every governed action receives a fresh CLONE_NEWPID namespace.
+ * Sandbox recovery ownership is closed to:
+ * D2B-BZLEXEC-SANDBOX-NAMESPACE,
+ * D2B-BZLEXEC-SANDBOX-PTRACE-POLICY,
+ * D2B-BZLEXEC-SANDBOX-MONITOR,
+ * D2B-BZLEXEC-SANDBOX-KILL,
+ * D2B-BZLEXEC-SANDBOX-REAP,
+ * D2B-BZLEXEC-SANDBOX-CEILING,
+ * D2B-BZLEXEC-SANDBOX-PENDING-KERNEL-CLEANUP, and
+ * D2B-BZLEXEC-SANDBOX-CLEANUP.
+ */
+static const char kD2BPolicyAbi[] = "d2b-bazel-seccomp-abi-v1";
+static const char kD2BPolicyAbiSha256[] =
+    "b0ab93e7faa7393d4af87552ae33d0030d88f3d52d0ff4742f578bfb58c9e21f";
+static const char kD2BPreflightFailure[] = "D2B-BZLNET-PREFLIGHT";
+static const char kD2BFilterFailure[] = "D2B-BZLNET-FILTER-LOAD";
+static const char kD2BSandboxPolicyFailure[] =
+    "D2B-BZLEXEC-SANDBOX-PTRACE-POLICY";
+static const char kD2BPendingCleanup[] =
+    "D2B-BZLEXEC-SANDBOX-PENDING-KERNEL-CLEANUP";
+static const char kD2BPendingRunbook[] =
+    "docs/contributing/critical-subsystems.md#bazel-pending-kernel-cleanup-quarantine";
+static const char kD2BConsumingReapRelease[] =
+    "D2B-BZLEXEC-SANDBOX-CONSUMING-REAP-RELEASE";
+static void D2BPrintSandboxDiagnostic(const char *code) {
+  fprintf(stderr, "%s\n", code);
+  fprintf(stderr, "input=pkgs/bazel-8.6.0-seccomp/linux-sandbox-seccomp.patch\n");
+  fprintf(stderr, "correction=Restore the pinned sandbox patch and policy; run make test-flake.\n");
+  fprintf(stderr, "retry=make test-flake\n");
+}
+
+static void D2BFail(const char *code) {
+  D2BPrintSandboxDiagnostic(code);
+  _exit(EXIT_FAILURE);
+}
