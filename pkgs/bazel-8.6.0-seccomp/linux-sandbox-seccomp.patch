+static void D2BPrepareActionPolicy() {
+  if (!D2BInheritedDescriptorPreflight()) {
+    D2BFail(kD2BPreflightFailure);
+  }
+  if (!D2BPolicyIdentityMatches()) {
+    D2BFail(kD2BSandboxPolicyFailure);
+  }
+  if (!D2BInstallFilter()) {
+    D2BFail(kD2BFilterFailure);
+  }
+}
