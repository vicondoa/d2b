package(default_visibility = ["//visibility:public"])

platform(
    name = "x86_64_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "buildbuddy_x86_64_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "d2b.platform": "linux-x86_64",
        "d2b.toolchain": "rules_rust",
        "d2b.worker-image": "d2b-bazel-worker/v1",
    },
)

platform(
    name = "buildbuddy_aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "d2b.platform": "linux-aarch64",
        "d2b.toolchain": "rules_rust",
        "d2b.worker-image": "d2b-bazel-worker/v1",
    },
)
