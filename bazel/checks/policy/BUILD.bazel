package(default_visibility = ["//visibility:public"])

filegroup(
    name = "carrier_sources",
    srcs = [
        "//:nix_workspace_sources",
        "//:nixos_modules_workspace_sources",
        "//:proof_workspace_sources",
        "//:tests_root_sources",
        "//bazel/checks/rust:repo_policy_sources",
        "//tests/unit/gates:gate_sources",
        "//tests/unit/meta:meta_sources",
    ],
)

test_suite(
    name = "changelog",
    tests = ["//packages/d2b-contract-tests:policy_changelog_gate"],
)

test_suite(
    name = "lint",
    tests = [
        "//packages/d2b-contract-tests:policy_bazel_layout",
        "//packages/xtask:workspace_lint",
    ],
)

test_suite(
    name = "policy",
    tests = [
        "//packages/d2b-contract-tests:policy_bazel_layout",
        "//packages/d2b-contract-tests:policy_source",
        "//packages/xtask:buildbuddy_config",
        "//packages/xtask:policy_ci",
        "//packages/xtask:policy_workspace",
        ":rust_policy",
    ],
)

test_suite(
    name = "rust_policy",
    tests = [
        "//packages/d2b-contract-tests:policy_source",
        "//tests/tools/no-bash-ast-walker:no_bash_ast_test",
        "//packages/d2b:stub_no_socket",
        "//packages/d2bd:stub_no_socket",
        "//packages/xtask:runtime_ledger_test",
        "//packages/xtask:schema_reproducibility_test",
    ],
)

test_suite(
    name = "proofs",
    tests = [
        "//proofs/chunked-stdio-conformance:clippy",
        "//proofs/chunked-stdio-conformance:doc",
        "//proofs/chunked-stdio-conformance:unit",
        "//proofs/redb-resource-store-spike:clippy",
        "//proofs/redb-resource-store-spike:doc",
        "//proofs/redb-resource-store-spike:full_scale_smoke",
        "//proofs/redb-resource-store-spike:unit",
        "//proofs/w0-ch-connect-proof:clippy",
        "//proofs/w0-ch-connect-proof:doc",
        "//proofs/w0-ch-connect-proof:unit",
        "//proofs/window-identity-chrome:clippy",
        "//proofs/window-identity-chrome:doc",
        "//proofs/window-identity-chrome:unit",
    ],
)

test_suite(
    name = "drift",
    tags = [
        "local",
        "no-sandbox",
    ],
    tests = [
        "//tests/unit/gates:drift_check",
        "//tests/unit/gates:vms_json_parity",
    ],
)

test_suite(
    name = "runtime_ledger",
    tests = ["//packages/xtask:runtime_ledger_test"],
)

test_suite(
    name = "policy_tooling",
    tests = [
        "//bazel/checks/meta:tier0",
        ":changelog",
        ":drift",
        ":lint",
        ":policy",
        ":runtime_ledger",
    ],
)
