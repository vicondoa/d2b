nix_unit_case_tests(_NIX_UNIT_GROUP_CASES, [":nix_unit_inputs"])

nix_native_test(
    name = "nix-unit-integrity",
    command = 'eval --no-write-lock-file --raw "$FLAKE_REF#checks.${SYSTEM}.nix-unit.drvPath" >/dev/null',
    lane = "nix-unit-integrity",
    max_kib = 10683720,
    data = [":nix_unit_inputs"],
    uses_nix_unit = True,
)

nix_native_test(
    name = "flake-eval-x86",
    command = """--no-instantiate --workers 1 --max-memory-size 8192 --flake "$FLAKE_REF#checks.x86_64-linux" --select 'checks: builtins.removeAttrs checks [ "nix-unit" "nix-unit-daemon" "nix-unit-guest" "nix-unit-misc" "nix-unit-network" "nix-unit-runtime" "nix-unit-state" "video-binary-contract" "gas-city-package-smoke" ]'""",
    lane = "flake",
    max_kib = 14665373,
    data = [":flake_eval_inputs"],
    uses_eval_jobs = True,
)

nix_native_test(
    name = "flake-eval-x86-realized",
    command = """build --no-write-lock-file --no-link --print-out-paths "$FLAKE_REF#checks.x86_64-linux.video-binary-contract" "$FLAKE_REF#checks.x86_64-linux.gas-city-package-smoke" "$FLAKE_REF#checks.x86_64-linux.rust-deny" "$FLAKE_REF#checks.x86_64-linux.guest-rust-deny" "$FLAKE_REF#checks.x86_64-linux.rust-audit" >/dev/null""",
    lane = "flake-realized",
    max_kib = 14665373,
    data = [":flake_eval_inputs"],
)

nix_native_test(
    name = "flake-eval-x86-outputs",
    command = """--no-instantiate --workers 1 --max-memory-size 8192 --flake "$FLAKE_REF#packages.x86_64-linux" """,
    lane = "flake-outputs",
    max_kib = 14665373,
    data = [":flake_eval_inputs"],
    uses_eval_jobs = True,
)

nix_native_test(
    name = "flake-eval-aarch64",
    command = """eval --no-write-lock-file --raw --impure --expr "(import \\"$SMOKE_PATH\\" { pkgs = import (builtins.getFlake \\"$FLAKE_REF\\").inputs.nixpkgs { system = \\"aarch64-linux\\"; }; }).drvPath" >/dev/null""",
    lane = "flake-aarch64",
    max_kib = 14665373,
    data = [":aarch64_smoke_inputs"],
    smoke = True,
)

