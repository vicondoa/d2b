nix_native_test(
    name = "flake-eval-x86",
    command = 'eval --no-write-lock-file --raw "$FLAKE_REF#checks.x86_64-linux.eval-minimal.drvPath" >/dev/null',
    lane = "flake",
    max_kib = 14665373,
    data = ["//:flake.lock"],
)

nix_native_test(
    name = "flake-eval-x86-outputs",
    command = 'eval --no-write-lock-file --raw "$FLAKE_REF#packages.x86_64-linux.d2b-resource-compiler.drvPath" >/dev/null',
    lane = "flake-outputs",
    max_kib = 14665373,
    data = ["//:flake.lock"],
)

nix_native_test(
    name = "flake-eval-x86-realized-video",
    command = 'build --no-write-lock-file --no-link --print-out-paths "$FLAKE_REF#checks.x86_64-linux.video-binary-contract" >/dev/null',
    lane = "flake-realized-video",
    max_kib = 14665373,
    data = ["//:flake.lock"],
    timeout = "eternal",
)

nix_native_test(
