# Module resolution is part of the committed build input.
common --enable_bzlmod
common --noenable_workspace
common --lockfile_mode=error
common --check_direct_dependencies=error
common --incompatible_strict_action_env
common --spawn_strategy=sandboxed
common --strategy=Genrule=sandboxed
common --strategy=CppCompile=sandboxed
common --strategy=CppLink=sandboxed
common --strategy=FileWrite=sandboxed
common --strategy=SymlinkTree=sandboxed
common --strategy=Rustc=sandboxed
common --strategy=RustcMetadata=sandboxed
common --strategy=Clippy=sandboxed
common --strategy=Rustdoc=sandboxed
common --strategy=RustdocTestCompile=sandboxed
common --strategy=RustdocTestWriter=sandboxed
common --strategy=Rustfmt=sandboxed
common --strategy=RustUnpretty=sandboxed
common --strategy=CargoBuildScriptRun=sandboxed
common --strategy=TestRunner=sandboxed

# Keep ordinary local output concise without changing the server identity.
build --show_timestamps
test --test_output=errors

# Named configurations are explicit and local; no global Rust channel is set.
build:dbg --compilation_mode=dbg
build:opt --compilation_mode=opt
